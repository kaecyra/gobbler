package canada

import "github.com/kaecyra/gobbler/internal/web/layout"

// part is one row of the "Where it runs" list.
type part struct {
	Part, Where string
	InCanada    bool
	Note        string
}

// parts says where each part of gobbler runs. The rows name the US companies
// still in the path as plainly as the Canadian ones; keep them true when the
// deployment changes.
var parts = []part{
	{"The app and its database", "A virtual machine in Montréal, Québec", true, "Everything you save is stored here."},
	{"Backups", "Nightly snapshots on the same machine", true, "A second machine on the same network is planned."},
	{"Secure tunnel", "Cloudflare", false, "Connects the home server to the internet without opening a port. It carries traffic between your browser and the server and can read it in transit. Recipes are not stored there."},
	{"Sign-in", "Google", false, "Confirms your email address when you sign in. gobbler keeps only that address and its own session."},
	{"LLM recipe parsing", "Anthropic Claude or Google Gemini", false, "Sees only the text or photo being imported, and only after the built-in parser has tried. Nothing it returns is saved until you review it."},
	{"Recipe videos", "YouTube", false, "Loads only when you press play."},
}

templ page() {
	@layout.Page("Made in Canada") {
		@styles()
		<div class="canada" data-testid="canada">
			<section class="ca-hero">
				<div class="ca-hero-text">
					<p class="ca-kicker">
						@layout.MapleLeaf("ca-kicker-leaf")
						<span>Made in Canada</span>
					</p>
					<h1>Your recipes stay in Canada</h1>
					<p class="ca-lede">gobbler was written in Canada and runs on a computer I own in Montréal, Québec. Your recipes, notes and shopping lists are stored on that machine, under Canadian law.</p>
				</div>
				<div class="ca-hero-art" aria-hidden="true">
					@layout.MapleLeaf("ca-big-leaf")
					<img class="ca-mascot" src={ layout.MascotPie } alt="" width="834" height="1084"/>
				</div>
			</section>
			<section class="ca-reasons">
				<div>
					<h2>Who holds your data</h2>
					<p>Several American cloud providers offer a Canadian region. The data in that region still belongs to an American company, and the <a href="https://www.eff.org/deeplinks/2018/02/cloud-act-dangerous-expansion-police-snooping-cross-border-data" target="_blank" rel="noopener">US CLOUD Act</a> lets US authorities compel a US provider to hand over data it controls, wherever that data is stored. gobbler is run by a Canadian on a machine in Canada, so a legal demand for its data has to come through a Canadian court.</p>
				</div>
				<div>
					<h2>This should matter to you</h2>
					<p>Trade between Canada and the United States has been in dispute for several years, and the terms have changed more than once with little warning. I want a household's recipes and notes to stay where they are, whatever happens in those talks.</p>
				</div>
				<div>
					<h2>Small on purpose</h2>
					<p>A household recipe box fits on one small machine, which makes it easy to reason about: I know where the disk is, who holds the keys, and what happens when the power goes out. The nightly backups stay on hardware here as well. gobbler has no ads, trackers or analytics.</p>
				</div>
			</section>
			<section class="ca-parts">
				<h2>Where it runs</h2>
				<p>Most of gobbler runs in Canada. A few parts still depend on American companies, and each one is listed here with what it can see.</p>
				<ul data-testid="canada-parts">
					for _, p := range parts {
						<li>
							<div class="ca-part">
								<b>{ p.Part }</b>
								<span>{ p.Where }</span>
							</div>
							if p.InCanada {
								<span class="ca-badge ca-badge-ca">
									@layout.MapleLeaf("ca-badge-leaf")
									<span>Canada</span>
								</span>
							} else {
								<span class="ca-badge ca-badge-us">United States</span>
							}
							<p class="ca-note">{ p.Note }</p>
						</li>
					}
				</ul>
			</section>
		</div>
	}
}
