package sharing

import (
	"github.com/kaecyra/gobbler/internal/web/layout"
)

templ inboxPage(v inboxView) {
	@layout.Page("Shared with you") {
		<div class="pg">
			<div class="screen-h"><h1>Shared with you</h1></div>
			if len(v.Offers) == 0 {
				<div class="panel empty">
					<img src={ layout.MascotHerbs } alt="" width="110" height="110"/>
					<p data-testid="no-shares">Nothing is waiting. Another household can send you a copy of a recipe; it arrives here and joins your recipes only if you accept it.</p>
				</div>
			} else {
				<section class="panel">
					<ul class="list" data-testid="shares">
						for _, o := range v.Offers {
							<li data-testid="share">
								<span class="grow">
									<strong>{ o.RecipeName }</strong>
									<span class="muted"> from { o.Sender }, { o.Sent }</span>
								</span>
								<form class="row-form" method="post" action={ templ.SafeURL(o.AcceptPath) }>
									<button type="submit" class="btn accent" aria-label={ "Accept " + o.RecipeName }>Accept</button>
								</form>
								<form class="row-form" method="post" action={ templ.SafeURL(o.DeclinePath) }>
									<button type="submit" class="btn" aria-label={ "Decline " + o.RecipeName }>Decline</button>
								</form>
							</li>
						}
					</ul>
				</section>
			}
		</div>
	}
}

templ sendPage(v sendView) {
	@layout.Page("Share a recipe") {
		<div class="pg">
			<div class="screen-h">
				<div>
					<h1>Share <span data-testid="recipe-name">{ v.RecipeName }</span></h1>
					<p>Name a member of the household to send it to. They get a copy to accept or decline; later edits on either side stay on that side. Your notes, history and rating are not sent.</p>
				</div>
			</div>
			<section class="panel">
				<form class="fields" method="post" action={ templ.SafeURL(v.Action()) }>
					<label>Email address <input type="email" name="email" required/></label>
					<button type="submit" class="btn accent">Send a copy</button>
				</form>
			</section>
		</div>
	}
}

templ sentPage() {
	@layout.Page("Recipe sent") {
		<div class="pg">
			<div class="screen-h"><h1>Sent</h1></div>
			<section class="panel">
				<p data-testid="sent">If that address belongs to a member of a household, the recipe is now waiting for them to accept it.</p>
				<p><a class="link" href="/recipes">Back to recipes</a></p>
			</section>
		</div>
	}
}
