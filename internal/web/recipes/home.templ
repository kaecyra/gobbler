package recipes

import (
	"github.com/kaecyra/gobbler/internal/web/layout"
)

// homePage is the landing page: the hero search, a suggestion and the recently
// made panel. Typing in the search moves to the library through htmx, with the
// address bar following, so Back returns here.
templ homePage(h homeView) {
	@layout.Page("Home") {
		@templ.Raw("<style>" + libraryStyle + "</style>")
		@layout.PictureFallback()
		@focusKey()
		<section id="library">
			<form
				id="hero"
				class="hero"
				role="search"
				action="/recipes"
				method="get"
				hx-get="/recipes"
				hx-target="#content"
				hx-select="#content"
				hx-swap="outerHTML"
				hx-push-url="true"
				hx-trigger="input changed delay:300ms from:find input[type=search], submit"
			>
				<h1>What are we making?</h1>
				@searchBox("")
				<p>Search by name, ingredient or anything you wrote in a note.</p>
			</form>
			if h.Empty {
				@emptyLibrary()
			} else if h.Suggest != nil || len(h.Recent) > 0 {
				<div class="lib home">
					<div class="side">
						if h.Suggest != nil {
							@suggestion(*h.Suggest)
						}
						@recentPanel(h.Recent)
					</div>
				</div>
			}
		</section>
	}
}

// suggestion is the pick on home and in the library's side: a recipe never
// made, or not made for a while. It is the mascot's voice line and when the
// recipe was last made above a library card (recipeCard, so it looks and opens
// like any other), and "Another idea" below it, which replaces just this block.
templ suggestion(s suggestView) {
	<section class="suggest" id="suggest" aria-label="A suggestion from gobbler">
		<div class="sg-voice">
			<img src={ layout.MascotTasting } alt="" width="44" height="44"/>
			<div>
				<p>{ s.Voice }</p>
				<p class="sg-when">{ s.When }</p>
			</div>
		</div>
		@recipeCard(s.Card)
		if s.NextHref != "" {
			<a
				class="sg-next"
				href={ templ.SafeURL(s.NextHref) }
				hx-get={ s.NextHref }
				hx-target="#suggest"
				hx-swap="outerHTML"
			>Another idea</a>
		}
	</section>
}
