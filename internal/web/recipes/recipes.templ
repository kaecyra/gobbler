package recipes

import "github.com/kaecyra/gobbler/internal/web/layout"

// libraryPage is the library: the search box, then the results beside the side
// panels (docs/ui/design.md, Screens). The search box is outside the results,
// so it keeps its focus while the results are swapped.
templ libraryPage(res results, side sideView) {
	@layout.Page("Recipes") {
		@templ.Raw("<style>" + libraryStyle + "</style>")
		@ribbonAssets()
		@focusKey()
		<section id="library">
			<form
				id="recipe-search"
				class="hero compact"
				role="search"
				action="/recipes"
				method="get"
				hx-get="/recipes"
				hx-target="#results"
				hx-push-url="true"
				hx-trigger="input changed delay:300ms from:find input[type=search], submit"
			>
				<h1 class="sr">Recipes</h1>
				@searchBox(res.Query)
			</form>
			<div class="lib">
				<div class="listcol">
					<div id="results" aria-live="polite">
						@resultsFragment(res)
					</div>
				</div>
				<aside class="side" aria-label="From your kitchen">
					if side.Suggest != nil {
						@suggestion(*side.Suggest)
					}
					@recentPanel(side.Recent)
					@forgotPanel(side.Forgot)
				</aside>
			</div>
		</section>
	}
}

// resultsFragment is what the search box and the group-by links replace: the
// count, the grouping switch and the cards. The grouping travels as a hidden
// field tied to the search form, so a search typed after choosing it keeps it.
templ resultsFragment(res results) {
	if res.Group == "time" {
		<input type="hidden" name="group" value="time" form="recipe-search"/>
	}
	if len(res.Groups) == 0 {
		if res.Filtered {
			<p class="res-h" data-testid="no-match">No recipes match. Try fewer words.</p>
		} else {
			@emptyLibrary()
		}
	} else {
		<div class="grpby-row">
			<p class="res-h"><b>{ res.Heading }</b></p>
			<div class="grpby">
				<span class="eyebrow">Group by</span>
				<div class="seg" role="group" aria-label="Group recipes by">
					@groupLink("Meal", res.MealHref, res.Group != "time")
					@groupLink("Time to table", res.TimeHref, res.Group == "time")
				</div>
			</div>
		</div>
		<div class="groups">
			for _, g := range res.Groups {
				<section class="group" aria-label={ g.Title }>
					<h2 class="grp-h">
						if g.Meal != "" {
							@mealIcon(g.Meal)
						}
						{ g.Title }
						<small>{ itoa(len(g.Cards)) }</small>
					</h2>
					<div class="cards">
						for _, c := range g.Cards {
							@recipeCard(c)
						}
					</div>
				</section>
			}
		</div>
	}
}

templ groupLink(label, href string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		hx-get={ href }
		hx-target="#results"
		hx-push-url="true"
		if current {
			aria-current="true"
		}
	>{ label }</a>
}

// recentPanel lists the latest made-it entries.
templ recentPanel(items []recentView) {
	<div class="panel" data-testid="recently-made">
		<h2>Recently made</h2>
		if len(items) == 0 {
			<p class="muted">Nothing made yet.</p>
		} else {
			<ul class="made">
				for _, it := range items {
					<li>
						<div class="date"><b>{ it.Day }</b><span>{ it.Month }</span></div>
						<div>
							<a href={ templ.SafeURL(it.Href) }>{ it.Name }</a>
							<em>{ it.Note }</em>
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

// forgotPanel names the recipe made longest ago. It is absent when nothing has
// been made.
templ forgotPanel(f *forgotView) {
	if f != nil {
		<div class="panel forgot" data-testid="forgot">
			<h2>Haven&rsquo;t made in a while</h2>
			<img src={ layout.MascotMixingBowl } alt="" height="72"/>
			<div>
				<a href={ templ.SafeURL(f.Href) }>{ f.Name }</a>
				<p>{ f.Text }</p>
			</div>
		</div>
	}
}
