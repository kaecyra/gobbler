package recipes

import (
	"github.com/kaecyra/gobbler/internal/recipe"
	"github.com/kaecyra/gobbler/internal/web/layout"
	"github.com/kaecyra/gobbler/internal/web/ribbon"
)

// mealType is the icon and label of a meal type, centred on each other.
templ mealType(m recipe.MealType, label string) {
	<span class="mtype" data-meal={ string(m) }>
		@layout.MealIcon(m)
		<span class="lbl">{ label }</span>
	</span>
}

// heat draws 1 to 3 chilis with a spoken label. Nothing is drawn for 0.
templ heat(n int, label string) {
	if n > 0 {
		<span class="heat" role="img" aria-label={ label } title={ label }>
			for range n {
				@layout.Chili()
			}
		</span>
	}
}

// spoons draws a rating of 1 to layout.MaxSpoons wooden spoons, never stars.
templ spoons(n int, label string) {
	<span class="spoons" role="img" aria-label={ label } title={ label }>
		for _, on := range layout.SpoonsOn(n) {
			@layout.Spoon(on)
		}
	</span>
}

// searchBox is the big search field: an icon, the input and the "/" hint. The
// input keeps its id across swaps, so htmx keeps the caret while results change.
templ searchBox(value string) {
	<label class="search" for="q">
		@layout.Icon(layout.IconSearch)
		<input id="q" type="search" name="q" value={ value } placeholder="Try &ldquo;chickpea&rdquo;, &ldquo;overnight&rdquo; or &ldquo;Sam liked it&rdquo;" autocomplete="off" aria-label="Search recipes"/>
		<kbd aria-hidden="true">/</kbd>
	</label>
}

// focusKey focuses the search box when "/" is pressed outside a text field. It
// is guarded, because htmx runs the script again each time a page that holds it
// is swapped in.
templ focusKey() {
	<script>
		if (!window.gobblerSlashFocus) {
			window.gobblerSlashFocus = true;
			document.addEventListener('keydown', function (e) {
				if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || e.defaultPrevented) return;
				var t = e.target;
				if (t && t.closest && t.closest('input, textarea, select, [contenteditable]')) return;
				var q = document.getElementById('q');
				if (!q) return;
				e.preventDefault();
				q.focus();
			});
		}
	</script>
}

// ribbonAssets links the ribbon's stylesheet and fit script.
templ ribbonAssets() {
	<link rel="stylesheet" href={ ribbon.StylesheetPath }/>
	<script src={ ribbon.ScriptPath } defer></script>
}

// cardPicture is the top of a card (ADR-00039, Showing): the recipe's picture,
// full-bleed and fading into the card, or the placeholder band of the same
// height, which also sits under a picture while it loads and is all that is
// left when the picture's object is gone (pictureFallback). The band carries
// the recipe's meal-type picture and one of the .ph0 to .ph5 variants. It is
// decoration, so it has no accessible name and the card's title link is the
// way in.
templ cardPicture(c cardView) {
	<div class={ "rpic", "ph", "ph" + itoa(bandVariant(c.ID)) } data-testid="card-picture" data-pic?={ c.Picture != "" }>
		if c.Picture != "" {
			<img src={ c.Picture } alt="" width="1024" height="300" loading="lazy" decoding="async" data-pic-img/>
		}
		if c.Meal != "" {
			<span class="phmark">
				@layout.MealIcon(c.Meal)
			</span>
		}
	</div>
}

// pictureFallback turns a picture that fails to load into its placeholder
// band: the library answers a recipe's picture address with 404 when the
// object is missing from the media store (the picture route logs it), and an
// <img> cannot fall back by itself. It listens once per page and also looks at
// pictures that had already failed when it ran. An htmx swap runs it again for
// the new cards.
templ pictureFallback() {
	<script>
		(function () {
			function drop(img) {
				var box = img.closest('[data-pic]');
				if (box) box.removeAttribute('data-pic');
				img.remove();
			}
			if (!window.gobblerPictureFallback) {
				window.gobblerPictureFallback = true;
				document.addEventListener('error', function (e) {
					if (e.target && e.target.tagName === 'IMG' && e.target.hasAttribute('data-pic-img')) drop(e.target);
				}, true);
			}
			document.querySelectorAll('img[data-pic-img]').forEach(function (img) {
				if (img.complete && img.naturalWidth === 0) drop(img);
			});
		})();
	</script>
}

// recipeCard is one library card: meal type and chilis, title and source,
// components, key ingredients, rating and made-it line, and the time ribbon
// pinned to the bottom. The title link is stretched over the whole card.
templ recipeCard(c cardView) {
	<article class="rcard">
		@cardPicture(c)
		<div class="ctop">
			if c.Meal != "" {
				@mealType(c.Meal, c.MealLabel)
			} else {
				<span></span>
			}
			@heat(c.Spice, c.SpiceLabel)
		</div>
		<div>
			<h3><a href={ templ.SafeURL(c.Href) }>{ c.Name }</a></h3>
			if c.Source != "" {
				<div class="src">{ c.Source }</div>
			}
			if c.Cuisine != "" {
				<div class="src" data-testid="card-cuisine">{ c.Cuisine }</div>
			}
		</div>
		if len(c.Components) > 0 {
			<ul class="comps" aria-label="Parts">
				for _, comp := range c.Components {
					<li>{ comp }</li>
				}
			</ul>
		}
		if len(c.Key) > 0 {
			<p class="key">
				<em>{ c.Key[0] }</em>
				if len(c.Key) > 1 {
					{ ", " + join(c.Key[1:]) }
				}
			</p>
		}
		<div class="rfoot">
			if c.Rating > 0 {
				@spoons(c.Rating, c.RatingLabel)
			} else {
				<span>New</span>
			}
			<span>{ c.Made }</span>
		</div>
		@ribbon.Card(c.Ribbon)
	</article>
}

// emptyLibrary is the empty state of a library with no recipes at all.
templ emptyLibrary() {
	<div class="empty" data-testid="empty-library">
		<img src={ layout.MascotTasting } alt="" width="110"/>
		<h3>No recipes yet</h3>
		<p>Add one from a URL, pasted text or a photo, and it will show up here.</p>
		<a class="btn accent" href="/ingest">Add a recipe</a>
	</div>
}
