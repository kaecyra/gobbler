package ribbon

import (
	"github.com/a-h/templ"

	"github.com/kaecyra/gobbler/internal/web/layout"
)

// Large is the ribbon on the recipe page, under "Ready in about...". It
// renders nothing when no step has a duration.
templ Large(r Ribbon) {
	if !r.Empty() {
		@ribbon(r, "rib rib-big")
	}
}

// ribbon prints both levels. Level 0 is shown until the script finds it does
// not fit and sets data-level.
templ ribbon(r Ribbon, class string) {
	<div class={ class, templ.KV("rib-merges", r.Merges()) } data-rib data-level="0" role="img" aria-label={ r.Label }>
		@level("rib-lv rib-full", r.Full)
		if r.Merges() {
			@level("rib-lv rib-merged", r.Merged)
		}
	</div>
}

templ level(class string, segs []Segment) {
	<div class={ class } aria-hidden="true">
		for _, s := range segs {
			<span class={ "rib-seg rib-" + string(s.Family) } style={ segmentStyle(s) } title={ s.Title }>
				if s.Active {
					@layout.Icon(layout.IconHand)
				} else {
					@layout.Icon(layout.IconClock)
				}
				{ s.Text }
			</span>
		}
	</div>
}

// segmentStyle sets the growth and, for a segment of several families, the
// gradient. Every value comes from Build, never from input.
func segmentStyle(s Segment) templ.SafeCSS {
	css := "flex-grow:" + s.Flex + ";"
	if s.Background != "" {
		css += "background:" + s.Background + ";"
	}
	return templ.SafeCSS(css)
}
