package layout

import (
	"context"
	"strconv"
)

// Page renders the document shell around its children: title, header with the
// navigation, the content slot and the footer (docs/ui/design.md).
templ Page(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - gobbler</title>
			<link rel="stylesheet" href={ StylesheetPath }/>
			<script src={ ThemePath }></script>
			<script src={ HTMXPath } defer></script>
		</head>
		<body>
			<header class="top">
				<div class="wrap">
					<a class="brand" href="/">
						<img class="standing" src={ MascotHeader } alt="" width="46" height="60"/>
						<span class="brand-text">
							<b>gobbler</b>
							<small>Find it. Cook it. Gobble it.</small>
						</span>
					</a>
					<nav class="tabs" aria-label="Primary">
						for _, item := range navItems {
							if !item.Menu && visible(ctx, item) {
								@navLink(ctx, item)
							}
						}
						if hasMenu(ctx) {
							<details class="menu" data-menu>
								<summary
									class="tab"
									role="button"
									aria-label="More sections"
									title="More sections"
									if menuCurrent(ctx) {
										data-current="true"
									}
								>
									@Icon(IconMenu)
									<span class="lbl-phone">More</span>
								</summary>
								<ul class="menu-list">
									for _, item := range navItems {
										if item.Menu && visible(ctx, item) {
											<li>@navLink(ctx, item)</li>
										}
									}
								</ul>
							</details>
						}
					</nav>
					@accountMenu(ctx)
				</div>
			</header>
			<main id="content">
				{ children... }
			</main>
			<footer class="wrap">
				<div class="foot">
					<span class="foot-src" data-testid="footer-source">
						<a href={ templ.SafeURL(RepositoryURL) } target="_blank" rel="noopener">
							@Icon(IconCode)
							<span>{ RepositoryDisplay }</span>
						</a>
						<span class="foot-ver" data-testid="app-version">{ versionLabel() }</span>
					</span>
					<span class="made-by">
						<span>Made by <a href={ templ.SafeURL(MakerURL) } target="_blank" rel="noopener">kaecyra</a> in <a href={ templ.SafeURL(CanadaPath) }>Canada</a></span>
						@MapleLeaf("leaf")
					</span>
				</div>
			</footer>
		</body>
	</html>
}

// navLink is one entry of the nav: a line icon and a label. The label hides
// below the widths where the bar is icons only, so the accessible name is set
// explicitly.
templ navLink(ctx context.Context, item navItem) {
	<a
		class={ "tab", templ.KV("cta", item.CTA) }
		href={ templ.SafeURL(item.Path) }
		aria-label={ item.Label }
		title={ item.Label }
		if isCurrent(ctx, item) {
			aria-current="page"
		}
	>
		@Icon(item.Icon)
		<span class="lbl">{ item.Label }</span>
	</a>
}

// ErrorPage renders a failed request inside the shared layout.
templ ErrorPage(status int, message string) {
	@Page(strconv.Itoa(status)) {
		<h1>{ strconv.Itoa(status) } { statusText(status) }</h1>
		<p class="muted">{ message }</p>
	}
}

// MapleLeaf is the red maple leaf, filled with currentColor so the caller's
// class sets its size and colour (--maple). The footer draws it beside "in
// Canada", and /canada draws it large. It is decorative, hidden from screen
// readers.
templ MapleLeaf(class string) {
	<svg class={ class } viewBox="0 0 36 36" aria-hidden="true" focusable="false"><path fill="currentColor" d="M36 20.917c0-.688-2.895-.5-3.125-1s3.208-4.584 2.708-5.5-5.086 1.167-5.375.708c-.288-.458.292-3.5-.208-3.875s-5.25 4.916-5.917 4.292c-.666-.625 1.542-10.5 1.086-10.698-.456-.198-3.419 1.365-3.793 1.282C21.002 6.042 18.682 0 18 0s-3.002 6.042-3.376 6.125c-.374.083-3.337-1.48-3.793-1.282-.456.198 1.752 10.073 1.085 10.698C11.25 16.166 6.5 10.875 6 11.25s.08 3.417-.208 3.875c-.289.458-4.875-1.625-5.375-.708s2.939 5 2.708 5.5-3.125.312-3.125 1 8.438 5.235 9 5.771c.562.535-2.914 2.802-2.417 3.229.576.496 3.839-.83 10.417-.957V35c0 .553.448 1 1 1 .553 0 1-.447 1-1v-6.04c6.577.127 9.841 1.453 10.417.957.496-.428-2.979-2.694-2.417-3.229.562-.536 9-5.084 9-5.771z"></path></svg>
}
