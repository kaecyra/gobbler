package ingest

import "github.com/kaecyra/gobbler/internal/web/layout"

templ photoPage(v photoView) {
	@layout.Page("Add a recipe from a photo") {
		@styles()
		<h1>Add a recipe from a photo</h1>
		<p class="muted">Upload a photo of a recipe page. The text is read on this server, then you review the result before anything is saved. The photo itself is not kept.</p>
		if v.Error != "" {
			<p class="error" role="alert">{ v.Error }</p>
		}
		<form class="ingest-form" method="post" action="/ingest/photo" enctype="multipart/form-data">
			<label for="ingest-photo">Photo</label>
			<input id="ingest-photo" type="file" name="photo" accept="image/png,image/jpeg,image/gif,image/webp,image/bmp"/>
			<div class="review-actions">
				<button type="submit">Read photo</button>
			</div>
		</form>
	}
}
