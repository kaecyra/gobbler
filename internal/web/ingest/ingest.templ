package ingest

import (
	ingestcore "github.com/kaecyra/gobbler/internal/ingest"
	"github.com/kaecyra/gobbler/internal/web/editor"
	"github.com/kaecyra/gobbler/internal/web/layout"
)

templ styles() {
	<style>
		.ingest-form label { display: block; font-weight: 600; margin-top: 0.75rem; }
		.ingest-form input[type=url], .ingest-form textarea { width: 100%; font: inherit; padding: 0.4rem; }
		.ingest-form textarea { min-height: 12rem; }
		.review-actions { display: flex; gap: 1rem; margin-top: 1.5rem; }
		.error { border: 2px solid var(--accent); padding: 0.5rem 0.75rem; margin: 1rem 0; }
		.low { border-left: 4px solid var(--accent); padding-left: 0.5rem; background: color-mix(in srgb, var(--accent) 10%, transparent); }
		.flag { color: var(--accent); font-weight: 700; margin-right: 0.4rem; }
		.llm-mark { border: 1px solid var(--border); border-radius: 3px; padding: 0 0.3rem; margin-right: 0.4rem; font-size: 0.8em; }
		.retry-form { margin: 1rem 0; }
	</style>
}

templ formPage(v formView) {
	@layout.Page("Add a recipe") {
		@styles()
		<h1>Add a recipe</h1>
		<p class="muted">Give a web address or paste the recipe text. You review the result before anything is saved.</p>
		if v.Error != "" {
			<p class="error" role="alert">{ v.Error }</p>
		}
		<p><a href="/ingest/photo">Or add a recipe from a photo</a></p>
		<form class="ingest-form" method="post" action="/ingest">
			<label for="ingest-url">Recipe URL</label>
			<input id="ingest-url" type="url" name="url" value={ v.URL } placeholder="https://"/>
			<label for="ingest-text">Or paste the recipe text</label>
			<textarea id="ingest-text" name="text">{ v.Text }</textarea>
			<div class="review-actions">
				<button type="submit">Read recipe</button>
			</div>
		</form>
	}
}

templ reviewPage(v reviewView) {
	@layout.Page("Review recipe") {
		@styles()
		<h1>Review recipe</h1>
		<p class="muted">Nothing is saved until you confirm.</p>
		@summary(v.Draft)
		if v.CanRetry {
			<form class="retry-form" method="post" action={ templ.SafeURL("/ingest/" + v.Token + "/retry") }>
				<button type="submit">Retry with LLM</button>
				<span class="muted">Asks the configured LLM to read the source again. Edits you have not confirmed are discarded. Nothing is saved.</span>
			</form>
		}
		<form id={ editor.CancelFormID } method="post" action={ templ.SafeURL("/ingest/" + v.Token + "/cancel") }></form>
		@v.Form.Component()
	}
}

// summary shows how sure the rules were, as words.
templ summary(d ingestcore.Draft) {
	<section class={ flagClass(d.BelowThreshold) } aria-label="Confidence">
		if d.LLMError != "" {
			<div class="error" role="alert">
				<p><strong>{ d.LLMError }</strong></p>
				<p>The draft below is unchanged. You can still review and save it.</p>
			</div>
		}
		if d.UsedLLM {
			<p><strong class="llm-mark">LLM</strong> The LLM filled the gaps the rules left. Check every item marked LLM before you confirm.</p>
		} else if d.BelowThreshold {
			<p><strong class="flag">Check this draft.</strong> The rules are not sure they read it correctly (confidence { percent(d.Overall) } of the { percent(d.Threshold) } needed). Look over every flagged item.</p>
		} else {
			<p>Confidence { percent(d.Overall) }.</p>
		}
		if d.ParserVersion != "" {
			<p class="muted">Parser version { d.ParserVersion }.</p>
		}
		if len(d.Issues) > 0 {
			<ul>
				for _, i := range d.Issues {
					<li>{ issueText(i) }</li>
				}
			</ul>
		}
		<p class="muted">Read from { sourceText(d) } using { string(d.Method) }.</p>
	</section>
}
