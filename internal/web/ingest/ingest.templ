package ingest

import (
	"fmt"

	ingestcore "github.com/kaecyra/gobbler/internal/ingest"
	"github.com/kaecyra/gobbler/internal/web/layout"
)

templ styles() {
	<style>
		.ingest-form label, .review label { display: block; font-weight: 600; margin-top: 0.75rem; }
		.ingest-form input[type=url], .ingest-form textarea, .review input[type=text], .review textarea { width: 100%; font: inherit; padding: 0.4rem; }
		.ingest-form textarea { min-height: 12rem; }
		.review-actions { display: flex; gap: 1rem; margin-top: 1.5rem; }
		.error, .problems { border: 2px solid var(--accent); padding: 0.5rem 0.75rem; margin: 1rem 0; }
		.lines, .steps { padding-left: 1.25rem; }
		.lines li, .steps li { margin: 0.5rem 0; }
		.low { border-left: 4px solid var(--accent); padding-left: 0.5rem; background: color-mix(in srgb, var(--accent) 10%, transparent); }
		.flag { color: var(--accent); font-weight: 700; margin-right: 0.4rem; }
		.new-ingredient { border: 1px dashed var(--border); padding: 0.25rem 0.5rem; }
		.times { display: flex; gap: 1.5rem; flex-wrap: wrap; }
	</style>
}

templ formPage(v formView) {
	@layout.Page("Add a recipe") {
		@styles()
		<h1>Add a recipe</h1>
		<p class="muted">Give a web address or paste the recipe text. You review the result before anything is saved.</p>
		if v.Error != "" {
			<p class="error" role="alert">{ v.Error }</p>
		}
		<form class="ingest-form" method="post" action="/ingest">
			<label for="ingest-url">Recipe URL</label>
			<input id="ingest-url" type="url" name="url" value={ v.URL } placeholder="https://"/>
			<label for="ingest-text">Or paste the recipe text</label>
			<textarea id="ingest-text" name="text">{ v.Text }</textarea>
			<div class="review-actions">
				<button type="submit">Read recipe</button>
			</div>
		</form>
	}
}

templ reviewPage(v reviewView) {
	@layout.Page("Review recipe") {
		@styles()
		<h1>Review recipe</h1>
		<p class="muted">Nothing is saved until you confirm.</p>
		@summary(v.Draft)
		if len(v.Problems) > 0 {
			<div class="problems" role="alert">
				<p><strong>This draft cannot be saved yet.</strong></p>
				<ul>
					for _, p := range v.Problems {
						<li>{ p }</li>
					}
				</ul>
			</div>
		}
		@proposed(v.Draft)
		<form class="review" method="post" action={ templ.SafeURL("/ingest/" + v.Token + "/confirm") }>
			<label for="f-name">Name</label>
			<div class={ flagClass(lowRequired(v.Draft.Name, v.Draft.Threshold)) }>
				@flagMark(lowRequired(v.Draft.Name, v.Draft.Threshold))
				<input id="f-name" type="text" name="name" value={ v.Draft.Name.Value }/>
			</div>
			<label for="f-author">Author</label>
			<div class={ flagClass(lowOptional(v.Draft.Author, v.Draft.Threshold)) }>
				@flagMark(lowOptional(v.Draft.Author, v.Draft.Threshold))
				<input id="f-author" type="text" name="author" value={ v.Draft.Author.Value }/>
			</div>
			<label for="f-description">Description</label>
			<div class={ flagClass(lowOptional(v.Draft.Description, v.Draft.Threshold)) }>
				@flagMark(lowOptional(v.Draft.Description, v.Draft.Threshold))
				<textarea id="f-description" name="description">{ v.Draft.Description.Value }</textarea>
			</div>
			@facts(v.Draft)
			for ci, c := range v.Draft.Components {
				<section class="component">
					if c.Name != "" {
						<h2>{ c.Name }</h2>
					} else {
						<h2>Ingredients and steps</h2>
					}
					<h3>Ingredients</h3>
					<ol class="lines">
						for li, l := range c.Lines {
							@lineItem(ci, li, l, v.Draft.Threshold)
						}
					</ol>
					<h3>Steps</h3>
					<ol class="steps">
						for si, s := range c.Steps {
							<li class={ flagClass(s.Confidence < v.Draft.Threshold) }>
								@flagMark(s.Confidence < v.Draft.Threshold)
								<textarea name={ stepField(ci, si) } aria-label={ fmt.Sprintf("Step %d", si+1) }>{ s.Text }</textarea>
								if s.Duration > 0 {
									<span class="muted">{ formatDuration(s.Duration) }</span>
								}
							</li>
						}
					</ol>
				</section>
			}
			<div class="review-actions">
				<button type="submit">Confirm and save</button>
				<button type="submit" formaction={ templ.SafeURL("/ingest/" + v.Token + "/cancel") } formnovalidate>Cancel</button>
			</div>
		</form>
	}
}

// summary shows how sure the rules were, as words.
templ summary(d ingestcore.Draft) {
	<section class={ flagClass(d.BelowThreshold) } aria-label="Confidence">
		if d.BelowThreshold {
			<p><strong class="flag">Check this draft.</strong> The rules are not sure they read it correctly (confidence { percent(d.Overall) } of the { percent(d.Threshold) } needed). Look over every flagged item.</p>
		} else {
			<p>Confidence { percent(d.Overall) }.</p>
		}
		if len(d.Issues) > 0 {
			<ul>
				for _, i := range d.Issues {
					<li>{ issueText(i) }</li>
				}
			</ul>
		}
		<p class="muted">Read from { sourceText(d) } using { string(d.Method) }.</p>
	</section>
}

// proposed lists the ingredients the catalog does not have. They are created,
// unreviewed, only when the draft is confirmed (ADR-00008).
templ proposed(d ingestcore.Draft) {
	if len(d.Proposed) > 0 || len(d.ProposedUnits) > 0 {
		<section class="new-ingredients" aria-label="New ingredients">
			<h2>New ingredients</h2>
			<p class="muted">The catalog does not have these. Confirming adds them as unreviewed ingredients, unless you map the line to an existing one below.</p>
			<ul>
				for _, p := range d.Proposed {
					<li data-proposed={ p.Name }><strong>{ p.Name }</strong> <span class="muted">aisle: { p.Aisle }</span></li>
				}
			</ul>
			if len(d.ProposedUnits) > 0 {
				<p class="muted">New units, also added unreviewed:</p>
				<ul>
					for _, u := range d.ProposedUnits {
						<li>{ u.Name }</li>
					}
				</ul>
			}
		</section>
	}
}

templ facts(d ingestcore.Draft) {
	<div class="times">
		if yieldText(d.Yield.Value) != "" {
			@fact("Yield", yieldText(d.Yield.Value), d.Yield.Confidence < d.Threshold)
		}
		if d.Prep.Value > 0 {
			@fact("Prep", formatDuration(d.Prep.Value), d.Prep.Confidence < d.Threshold)
		}
		if d.Cook.Value > 0 {
			@fact("Cook", formatDuration(d.Cook.Value), d.Cook.Confidence < d.Threshold)
		}
		if d.Total.Value > 0 {
			@fact("Total", formatDuration(d.Total.Value), d.Total.Confidence < d.Threshold)
		}
	</div>
}

templ fact(label, text string, low bool) {
	<p class={ flagClass(low) }>
		@flagMark(low)
		{ label }: { text }
	</p>
}

templ lineItem(ci, li int, l ingestcore.Line, threshold float64) {
	<li class={ flagClass(l.Confidence < threshold) } data-low?={ l.Confidence < threshold }>
		@flagMark(l.Confidence < threshold)
		<span class="raw">{ l.Raw }</span>
		<div class="muted">{ lineSummary(l) }</div>
		for _, issue := range l.Issues {
			<div class="muted">{ issue }</div>
		}
		if l.Ingredient == 0 {
			<div class="new-ingredient">
				<strong>New ingredient.</strong>
				<label for={ fmt.Sprintf("line-%d-%d-name", ci, li) }>Add as new ingredient named</label>
				<input id={ fmt.Sprintf("line-%d-%d-name", ci, li) } type="text" name={ lineNameField(ci, li) } value={ l.Name }/>
				<label for={ fmt.Sprintf("line-%d-%d-existing", ci, li) }>Or use an existing ingredient (type its name)</label>
				<input id={ fmt.Sprintf("line-%d-%d-existing", ci, li) } type="text" name={ lineExistingField(ci, li) }/>
			</div>
		}
	</li>
}
