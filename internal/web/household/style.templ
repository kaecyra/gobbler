package household

// PageStyle is the stylesheet of the plain form-and-list pages that have no
// mockup of their own (docs/ui/design.md, Screens): household, invitations,
// sharing, settings, the operator's pages, the equipment catalog and the
// not-a-member page. It is inline, as the editor's and the library's are, so
// a page needs no route of its own for it (every route needs an e2e probe in
// the tenancy suite), and a verified non-member, who can reach only the
// invitation routes, still gets it. Colours, radii and sizes are the tokens of
// app.css. Pages wrap their content in class "pg" so none of it leaks.
templ PageStyle() {
	<style>
		.pg { max-width: 760px; }
		.pg.wide { max-width: none; }
		.pg > .panel + .panel { margin-top: 16px; }
		.pg h2 { font-size: 20px; margin: 0 0 8px; }
		.pg p { margin: 0 0 12px; max-width: 62ch; }
		.pg p:last-child { margin-bottom: 0; }
		.pg label { display: block; font-weight: 600; font-size: 15px; color: var(--ink-2); }
		.pg input[type=text], .pg input[type=email], .pg input[type=search], .pg textarea, .pg select {
			display: block; width: 100%; max-width: 28rem; min-height: var(--tap); margin-top: 4px;
			padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--r);
			background: var(--card); color: var(--ink); font: inherit; font-weight: 400;
		}
		.pg input:focus-visible, .pg select:focus-visible, .pg textarea:focus-visible { border-color: var(--wattle); }
		.pg .fields { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
		.pg .fields label { flex: 1 1 16rem; max-width: 28rem; }
		.pg .fields.find label { flex-basis: 100%; max-width: none; }
		.pg .fields.find input { flex: 1 1 16rem; max-width: none; margin-top: 0; }
		.pg .list { list-style: none; margin: 0 0 12px; padding: 0; }
		.pg .list > li { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; padding: 6px 0; border-top: 1px solid var(--line); min-height: var(--tap); }
		.pg .list:last-child { margin-bottom: 0; }
		.pg .list > li:first-child { border-top: 0; }
		.pg .list .grow { flex: 1 1 14rem; min-width: 0; overflow-wrap: anywhere; }
		.pg .link, .pg .list a, .pg td a { display: inline-flex; align-items: center; min-height: var(--tap); }
		.pg .row-form { display: inline-flex; margin: 0; }
		.pg label.check { display: flex; align-items: center; gap: 10px; min-height: var(--tap); font-weight: 400; color: var(--ink); }
		.pg input[type=checkbox] { width: 22px; height: 22px; flex: none; accent-color: var(--wattle-ink); }
		.pg .hint { display: block; color: var(--ink-3); font-size: 14px; }
		.pg .stack > * + * { margin-top: 14px; }
		.pg .alert, .pg .field-error { background: var(--grain-soft); color: var(--grain-ink); border-radius: var(--r); padding: 10px 14px; }
		.pg .empty { padding: 20px 16px; }
		.pg .empty p { font-size: 16px; max-width: 46ch; margin: 0; }
		.pg dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0 0 16px; }
		.pg dt { color: var(--ink-3); font-weight: 600; }
		.pg dd { margin: 0; }
		.pg .table-wrap { overflow-x: auto; }
		.pg table { width: 100%; border-collapse: collapse; }
		.pg th, .pg td { text-align: left; padding: 6px 12px 6px 0; border-top: 1px solid var(--line); vertical-align: middle; }
		.pg thead th { border-top: 0; color: var(--ink-3); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
		.pg td form { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin: 0; }
	</style>
}
