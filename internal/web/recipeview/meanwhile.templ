package recipeview

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/recipe/display"
)

// meanwhile lists the work offered while a passive step runs. It renders
// nothing when there is none, so recipes without guidance look as before.
templ meanwhile(items []display.MeanwhileItem) {
	if len(items) > 0 {
		<div class="callout meanwhile" data-testid="meanwhile">
			<div class="co-label">
				@iconClock()
				<span>Meanwhile, while it waits</span>
			</div>
			<ul>
				for _, it := range items {
					<li><b>step { strconv.Itoa(it.Number) }:</b> <span>{ it.Text }</span></li>
				}
			</ul>
		</div>
	}
}
