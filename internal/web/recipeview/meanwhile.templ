package recipeview

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/recipe/display"
)

// meanwhile lists the work offered while a passive step runs. It renders
// nothing when there is none, so recipes without guidance look as before.
templ meanwhile(items []display.MeanwhileItem) {
	if len(items) > 0 {
		<div class="recipe-meanwhile" data-testid="meanwhile">
			<strong>Meanwhile</strong>
			<ul>
				for _, it := range items {
					<li>step { strconv.Itoa(it.Number) }: { it.Text }</li>
				}
			</ul>
		</div>
	}
}
