package recipeview

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/recipe"
	"github.com/kaecyra/gobbler/internal/recipe/display"
	"github.com/kaecyra/gobbler/internal/video"
	"github.com/kaecyra/gobbler/internal/web/layout"
	"github.com/kaecyra/gobbler/internal/web/ribbon"
)

// scalePresets are the one-tap multipliers; Param is the text sent as scale.
var scalePresets = []struct{ Param, Label string }{
	{"1/2", "½×"}, {"1", "1×"}, {"2", "2×"}, {"3", "3×"},
}

// unitModes are the display modes; Param is the text sent as units.
var unitModes = []struct{ Param, Label string }{
	{"", "As written"}, {display.UnitsMetric, "Metric"}, {display.UnitsWeight, "Weight"},
}

// libraryPath is the library, the first step of the breadcrumb.
const libraryPath = "/recipes"

// shoppingAddPath is where "Add to shopping list" posts: the shopping page puts
// the recipe on the household's newest list, or sends the household to
// /shopping to make one when it has none.
const shoppingAddPath = "/shopping/add"

// Paths of the player's own assets, embedded in the binary (ADR-00002).
const (
	videoStylesheetPath = "/static/video.css"
	videoScriptPath     = "/static/video.js"
)

// thumbnailHref is the stored preview of the recipe's video, reached through
// the recipe so the household check applies.
func thumbnailHref(id int64) string { return recipePath(id) + thumbnailRoute }

// videoWatchURL is where the play control goes without scripts. It is only
// followed when someone presses it.
func videoWatchURL(videoID string) string { return "https://www.youtube.com/watch?v=" + videoID }

// videoEmbedURL is the privacy-enhanced player that video.js loads on Play.
func videoEmbedURL(videoID string) string { return video.EmbedURL(videoID) }

// recipePath is the recipe page's path, the base of its sibling pages.
func recipePath(id int64) string {
	return "/recipes/" + strconv.FormatInt(id, 10)
}

// href is the URL of this recipe with the given state. Empty values are left
// out so the default view keeps the bare URL.
func href(id int64, scale, servings, units string) string {
	return display.StateURL(recipePath(id), scale, servings, units, nil)
}

// cookHref is the cook-mode page of this recipe with the same state. Cook mode
// is its own feature package (ADR-00012), so only its URL is known here.
func cookHref(id int64, o display.Options) string {
	return o.URL(recipePath(id)+"/cook", nil)
}

// journalHref is the journal of this recipe: loaded into the page by HTMX, and
// a plain link where scripts do not run. The journal is its own feature package
// (ADR-00012), so only its URL is known here.
func journalHref(id int64) string { return recipePath(id) + "/journal" }

// historyHref is the history page of this recipe.
func historyHref(id int64) string { return recipePath(id) + "/history" }

// cloneHref is where the clone form posts.
func cloneHref(id int64) string { return recipePath(id) + "/clone" }

// originHref is the history page of one version of the recipe a clone came from.
func originHref(o *originView) string {
	return historyHref(o.RecipeID) + "/" + strconv.FormatInt(o.Version, 10)
}

// editHref is the editor page of this recipe. The editor is its own feature
// package (ADR-00012), so only its URL is known here; it takes no display state.
func editHref(id int64) string {
	return recipePath(id) + "/edit"
}

// shareHref is the form that sends a copy of this recipe to another household.
// Sharing is its own feature package (ADR-00012), so only its URL is known here.
func shareHref(id int64) string {
	return "/shares/new/" + strconv.FormatInt(id, 10)
}

// stepNumber is the number printed in a step's marker.
func stepNumber(first, i int) string { return strconv.Itoa(first + i) }

func presetActive(v view, param string) bool {
	if v.Opts.Servings != "" {
		return false
	}
	if v.Opts.Scale == "" {
		return param == "1"
	}
	return v.Opts.Scale == param
}

templ recipePage(v view) {
	@layout.Page(v.Name) {
		<link rel="stylesheet" href={ ribbon.StylesheetPath }/>
		@layout.RecipeStyles()
		@authorNoteStyles()
		if v.VideoID != "" {
			@videoAssets()
		}
		if v.Proposal != nil {
			@proposalBanner(v)
		}
		if v.Reimport != nil {
			@reimportBanner(v)
		}
		@recipeBody(v)
		@aside(v)
		<script src={ ribbon.ScriptPath } defer></script>
	}
}

// videoAssets are the video's stylesheet and script. They sit on the page, not
// in #recipe, so a scale swap does not run the script a second time.
templ videoAssets() {
	<link rel="stylesheet" href={ videoStylesheetPath }/>
	<script src={ videoScriptPath } defer></script>
}

// videoPlayer is the recipe's video at the top of the steps column (ADR-00021). Until
// Play is pressed it holds no address of a YouTube origin that the browser
// would load: the thumbnail is the application's own copy, and the player's
// address sits in a data attribute that video.js reads on click. The control
// is a link to the video's watch page, which is what a browser without
// scripts follows; video.js replaces it with the embedded player. It sits in
// #recipe, which a scale swaps, so hx-preserve keeps the element, and a
// playing video, across the swap.
templ videoPlayer(v view) {
	<section id="recipe-video" class="recipe-video" aria-label="Video" data-testid="video" hx-preserve>
		<a
			class="recipe-video-play"
			href={ templ.URL(videoWatchURL(v.VideoID)) }
			rel="noopener noreferrer"
			data-video-play
			data-embed={ videoEmbedURL(v.VideoID) }
			data-title={ "Video: " + v.Name }
			data-testid="video-play"
		>
			if v.HasThumbnail {
				<img src={ thumbnailHref(v.ID) } alt="" loading="lazy" data-testid="video-thumbnail"/>
			}
			<span class="recipe-video-button">Play video</span>
		</a>
	</section>
}

// pictureHeader is the top of the page (ADR-00039, Showing): the recipe's
// picture kept short, or the placeholder band at the same height, with the
// title over the fade so the ingredients stay high on a tablet.
templ pictureHeader(v view) {
	@layout.PictureBand("rhero", "recipe-picture", v.ID, v.Meta.MealType, v.Picture, 1124, 210, false) {
		<h1>{ v.Name }</h1>
	}
	@layout.PictureFallback()
}

templ recipeBody(v view) {
	<article id="recipe" class="recipe">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href={ templ.SafeURL(libraryPath) }>Library</a>
			<span aria-hidden="true">/</span>
			if v.Meta.Meal != "" {
				<span>{ v.Meta.Meal }</span>
			} else {
				<span aria-current="page">{ v.Name }</span>
			}
		</nav>
		@pictureHeader(v)
		<div class="rhead">
			<div>
				if v.Description != "" {
					<p class="lede">{ v.Description }</p>
				}
				if v.Origin != nil {
					<p class="muted origin" data-testid="origin">
						Cloned from
						<a href={ templ.SafeURL(recipePath(v.Origin.RecipeID)) }>recipe { strconv.FormatInt(v.Origin.RecipeID, 10) }</a>
						at
						<a href={ templ.SafeURL(originHref(v.Origin)) }>version { strconv.FormatInt(v.Origin.Version, 10) }</a>.
					</p>
				}
				if v.Proposal.marked() && len(v.Proposal.Fields) > 0 {
					@fieldMarks(v.Proposal.Fields)
				}
				@layout.RecipeMetaRow(v.Meta)
				if len(v.Tags) > 0 {
					<ul class="recipe-tags">
						for _, t := range v.Tags {
							<li class="stag">{ t }</li>
						}
					</ul>
				}
				<p class="recipe-yield">
					if v.Servings != "" {
						<span>Serves <strong data-testid="servings">{ v.Servings }</strong></span>
					}
					if v.Yield != "" {
						<span>Makes <strong data-testid="yield">{ v.Yield }</strong></span>
					}
				</p>
			</div>
			@times(v)
		</div>
		@controls(v)
		if v.Notice != "" {
			<p role="alert" class="recipe-error" data-testid="view-error">{ v.Notice }</p>
		}
		if v.Scaled {
			<p class="muted" data-testid="scaled-note">Scaled by { v.Multiplier }. Quantities are rounded for the kitchen; hover one for the exact value.</p>
		}
		<div class="recipe-grid">
			<div class="ingr">
				if len(v.Equipment) > 0 {
					<section class="equip" aria-labelledby="equipment-h">
						<h2 id="equipment-h" class="eyebrow">Equipment</h2>
						<ul data-testid="equipment">
							for _, e := range v.Equipment {
								<li class="equip-chip" data-testid="equipment-item">
									@layout.EquipIcon(e.Name)
									<span>{ e.Text }</span>
									if e.Hint != "" {
										<span class="equip-hint" data-testid="equipment-hint">({ e.Hint })</span>
									}
								</li>
							}
						</ul>
					</section>
				}
				if v.hasLines() {
					<section aria-labelledby="ingredients-h">
						<h2 id="ingredients-h" class="eyebrow">Ingredients</h2>
						for ci, c := range v.Components {
							if len(c.Lines) > 0 || v.Proposal.comp(ci).hasLineAdds() {
								<div class="comp">
									if c.Name != "" {
										<h3>{ c.Name }</h3>
									}
									<ul class="ing">
										for _, a := range v.Proposal.comp(ci).LinesFirst {
											@addedLine(a)
										}
										for li, l := range c.Lines {
											<li class={ lineClass(v.Proposal.comp(ci).line(li)) }>
												if l.Exact != "" {
													<span title={ "exact: " + l.Exact }>@lineText(l)</span>
												} else {
													<span>@lineText(l)</span>
												}
												if l.Unscaled {
													<span class="muted"> (not scaled or converted: ingredient not matched)</span>
												}
												@lineMarkNote(v.Proposal.comp(ci).line(li))
											</li>
											for _, a := range v.Proposal.comp(ci).LinesAfter[li] {
												@addedLine(a)
											}
										}
									</ul>
								</div>
							}
						}
					</section>
				}
				if v.Proposal.marked() {
					for _, part := range v.Proposal.NewParts {
						@newPartMark(part)
					}
				}
			</div>
			<section class="method" aria-labelledby="steps-h">
				<h2 id="steps-h" class="sr">Steps</h2>
				if v.VideoID != "" {
					@videoPlayer(v)
				}
				for _, t := range v.Tips {
					<div class="tip" data-testid="tip">
						<div class="co-label">
							@layout.Icon(layout.IconBulb)
							<span>Tip</span>
						</div>
						<p>{ t } <small>From your notes</small></p>
					</div>
				}
				for ci, c := range v.Components {
					if len(c.Steps) > 0 || v.Proposal.comp(ci).hasStepAdds() {
						if c.Name != "" {
							<h3 class="part">{ c.Name }</h3>
						}
						<ol start={ strconv.Itoa(c.FirstStep) }>
							for _, a := range v.Proposal.comp(ci).StepsFirst {
								@addedStep(a)
							}
							for i, s := range c.Steps {
								@layout.RecipeStep(s, stepNumber(c.FirstStep, i))
								@stepMarkNote(v.Proposal.comp(ci).step(i), s.Text, stepNumber(c.FirstStep, i))
								for _, a := range v.Proposal.comp(ci).StepsAfter[i] {
									@addedStep(a)
								}
							}
							if ci == v.notesComponent() {
								for _, n := range v.Notes {
									@authorNote(n)
								}
							}
						</ol>
					}
				}
				if v.notesComponent() < 0 && len(v.Notes) > 0 {
					<ol>
						for _, n := range v.Notes {
							@authorNote(n)
						}
					</ol>
				}
			</section>
		</div>
	</article>
}

// authorNote is one of the author's notes, after the last step and apart from
// the chain (ADR-00041, ADR-00045): a bulb in a soft circle where a step number would be,
// the title in bold, the text, and a quiet credit. It is drawn after variant A
// of the recipe screen in docs/ui/mockup.html.
templ authorNote(n noteView) {
	<li class="step anote" data-testid="author-note">
		<div class="an" aria-hidden="true">
			<span>
				@layout.Icon(layout.IconBulb)
			</span>
		</div>
		<div>
			<p>
				if n.Lead != "" {
					<b data-testid="author-note-title">{ n.Lead }</b>
				}
				{ " " + n.Text }
				<small>From the author</small>
			</p>
		</div>
	</li>
}

// authorNoteStyles are the rules of an author note. The note takes the step's
// grid from layout.RecipeStyles and changes the number to a bulb and the text
// to a little smaller and lighter. No connector runs from the last step into
// the notes or between them, and the first note sits 24px (the list's own
// bottom margin) below the last step's usual gap (ADR-00045).
templ authorNoteStyles() {
	<style>
		.step.anote { grid-template-columns: 44px minmax(0, 1fr); padding-bottom: 22px; }
		.step.anote::before, .step:has(+ .anote)::before { display: none; }
		.step:not(.anote) + .step.anote { margin-top: 24px; }
		.step.anote .an { width: 44px; height: 44px; display: grid; place-items: center; position: relative; z-index: 1; }
		.step.anote .an span { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--wattle-soft); color: var(--wattle-ink); }
		.step.anote .an svg { width: 17px; height: 17px; }
		.step.anote p { margin: 9px 0 0; font-size: 17px; line-height: 1.55; color: var(--ink-2); max-width: 60ch; }
		.step.anote p b { color: var(--ink); font-weight: 650; }
		.step.anote small { color: var(--ink-3); font-size: 13.5px; font-weight: 450; white-space: nowrap; margin-left: 4px; }
	</style>
}

// aside holds what belongs to the recipe but not to its scaled view: it sits
// outside #recipe so scaling does not swap it, and the journal does not reload
// (and lose a half-typed note) on every tap.
templ aside(v view) {
	<aside aria-label="Recipe tools">
		<div class="recipe-after">
			<div data-testid="journal-slot" hx-get={ journalHref(v.ID) } hx-trigger="load" hx-swap="outerHTML">
				<a href={ templ.SafeURL(journalHref(v.ID)) } class="btn">Journal</a>
			</div>
			<div class="tools">
				<h2>History</h2>
				<ul class="tool-links">
					<li><a href={ templ.SafeURL(historyHref(v.ID)) } data-testid="history-link">History</a></li>
					<li><a href={ templ.SafeURL(editHref(v.ID)) } data-testid="edit-link">Edit</a></li>
					<li><a href={ templ.SafeURL(shareHref(v.ID)) } data-testid="share-link">Share</a></li>
					if v.CanReimport {
						@reimportButton(v)
					}
				</ul>
				<form method="post" action={ templ.SafeURL(cloneHref(v.ID)) }>
					<button type="submit" class="btn" data-testid="clone-button">Clone this recipe</button>
				</form>
				<p><a href={ templ.SafeURL(deleteHref(v.ID)) } class="btn danger" data-testid="delete-link">Delete recipe</a></p>
				<div class="snap"><i></i>Original source snapshot kept, unchanged</div>
			</div>
		</div>
	</aside>
}

// times is the ribbon's heading and the stated times. The derived total is
// the headline; prep, cook and the special times sit under the ribbon.
templ times(v view) {
	if v.readyIn() != "" || len(v.Times) > 0 || !v.Ribbon.Empty() {
		<div class="rtime">
			if v.readyIn() != "" {
				<span class="eyebrow">
					Ready in about
					<span data-testid="total">{ v.readyIn() }</span>
					if v.TotalNote != "" {
						<span class="muted"> ({ v.TotalNote })</span>
					}
				</span>
			}
			@ribbon.Large(v.Ribbon)
			if len(v.Times) > 0 {
				<dl class="recipe-times">
					for _, t := range v.Times {
						<div>
							<dt>{ t.Label }</dt>
							<dd>
								{ t.Text }
								if t.Hint != "" {
									<span class="muted"> ({ t.Hint })</span>
								}
							</dd>
						</div>
					}
				</dl>
			}
		</div>
	}
}

// controls are plain links and a GET form, so they work without scripts; the
// hx-* attributes only make HTMX swap the recipe in place.
templ controls(v view) {
	<div class="recipe-controls">
		<div class="seg" role="group" aria-label="Scale">
			for _, p := range scalePresets {
				<a
					href={ templ.SafeURL(href(v.ID, p.Param, "", v.Opts.Units)) }
					hx-get={ href(v.ID, p.Param, "", v.Opts.Units) }
					hx-target="#recipe"
					hx-select="#recipe"
					hx-swap="outerHTML"
					hx-push-url="true"
					if presetActive(v, p.Param) {
						aria-current="true"
					}
				>{ p.Label }</a>
			}
		</div>
		<form class="servings" method="get" action={ templ.SafeURL(href(v.ID, "", "", "")) } hx-get={ href(v.ID, "", "", "") } hx-target="#recipe" hx-select="#recipe" hx-swap="outerHTML" hx-push-url="true">
			<label>
				Servings
				<input type="text" name="servings" inputmode="decimal" value={ v.Opts.Servings } size="4"/>
			</label>
			if v.Opts.Units != "" {
				<input type="hidden" name="units" value={ v.Opts.Units }/>
			}
			<button type="submit" class="btn">Scale</button>
		</form>
		<div class="seg" role="group" aria-label="Units">
			for _, m := range unitModes {
				<a
					href={ templ.SafeURL(href(v.ID, v.Opts.Scale, v.Opts.Servings, m.Param)) }
					hx-get={ href(v.ID, v.Opts.Scale, v.Opts.Servings, m.Param) }
					hx-target="#recipe"
					hx-select="#recipe"
					hx-swap="outerHTML"
					hx-push-url="true"
					if v.Opts.Units == m.Param {
						aria-current="true"
					}
				>{ m.Label }</a>
			}
		</div>
		<span class="grow"></span>
		<form method="post" action={ templ.SafeURL(shoppingAddPath) } data-testid="shopping-add-form">
			<input type="hidden" name="recipe" value={ strconv.FormatInt(v.ID, 10) }/>
			<input type="hidden" name="multiplier" value={ v.Multiplier }/>
			<button type="submit" class="btn" data-testid="shopping-add">Add to shopping list</button>
		</form>
		<a class="btn accent cookbtn" href={ templ.SafeURL(cookHref(v.ID, v.Opts)) } data-testid="cook-link">
			@layout.Icon(layout.IconPot)
			<span>Cook mode</span>
		</a>
	</div>
}

// proposalBanner is the pending proposal's banner, above the recipe and outside
// #recipe, so scaling the recipe leaves it and its toggle alone (ADR-00035). The
// toggle hides the marks and the detail, leaving a compact banner; Reject and
// Review stay. A stale proposal can only be rejected.
templ proposalBanner(v view) {
	@proposalStyles()
	<section class={ "pbanner", templ.KV("stale", v.Proposal.Stale) } aria-label="Proposed change" data-testid="proposal-banner">
		if v.Proposal.Stale {
			<div class="phead">
				<strong>Out of date</strong>
				<span class="pwho">A proposal by { v.Proposal.By }.</span>
			</div>
			<p class="pdetail" data-testid="proposal-stale">{ staleBanner }</p>
			<div class="pactions">
				@rejectForm(v)
			</div>
		} else {
			<div class="phead">
				<strong>Proposed change</strong>
				<span class="pwho" data-testid="proposal-by">by { v.Proposal.By }</span>
				<span class="pwho">{ changeLabel(v.Proposal.Changes) }</span>
			</div>
			if v.Proposal.Reason != "" {
				<p class="pdetail preason" data-testid="proposal-reason">Reason: { v.Proposal.Reason }</p>
			}
			<div class="pactions">
				<a class="btn accent" href={ templ.SafeURL(reviewHref(v.ID, v.Proposal.Token)) } data-testid="proposal-review">Review</a>
				@rejectForm(v)
				<label class="ptoggle"><input type="checkbox" id="pmarks" checked data-testid="proposal-marks-toggle"/> Show changes</label>
			</div>
		}
	</section>
}

// reimportBanner announces a pending re-import. It has no marks: the draft is
// reviewed whole on the ingest screen (ADR-00042). Out of date, it offers
// Discard only.
templ reimportBanner(v view) {
	@proposalStyles()
	<section class={ "pbanner", templ.KV("stale", v.Reimport.Stale) } aria-label="Re-import" data-testid="reimport-banner">
		if v.Reimport.Stale {
			<div class="phead">
				<strong>Out of date</strong>
				<span class="pwho">A re-import from { v.Reimport.Host }.</span>
			</div>
			<p class="pdetail" data-testid="reimport-stale">{ staleReimportBanner }</p>
		} else {
			<div class="phead">
				<strong>A re-import is waiting for review</strong>
				<span class="pwho">from { v.Reimport.Host }</span>
			</div>
		}
		<div class="pactions">
			if !v.Reimport.Stale {
				<a class="btn accent" href={ templ.SafeURL(reimportReviewHref(v.Reimport.Token)) } data-testid="reimport-review">Review</a>
			}
			<form method="post" action={ templ.SafeURL(reimportDiscardHref(v.Reimport.Token)) }>
				<button type="submit" class="btn" data-testid="reimport-discard">Discard</button>
			</form>
		</div>
	</section>
}

// reimportButton starts a re-import. It is a POST button because starting one
// fetches the source and writes a snapshot and a draft, styled like the links
// above it.
templ reimportButton(v view) {
	<style>
		.tool-links li form { margin: 0; }
		.tool-links .linkbtn {
			display: flex; align-items: center; width: 100%; min-height: var(--tap); padding: 0;
			background: none; border: 0; font: inherit; color: var(--wattle-ink); text-align: left; cursor: pointer;
			text-decoration: underline;
		}
	</style>
	<li>
		<form method="post" action={ templ.SafeURL(reimportStartHref(v.ID)) }>
			<button type="submit" class="linkbtn" data-testid="reimport-button">Re-import from source</button>
		</form>
	</li>
}

templ rejectForm(v view) {
	<form method="post" action={ templ.SafeURL(rejectHref(v.ID)) }>
		<input type="hidden" name="proposal" value={ v.Proposal.Token }/>
		<button type="submit" class="btn" data-testid="proposal-reject">Reject</button>
	</form>
}

// fieldMarks lists the fields, parts and equipment the proposal changes, with
// the old value struck and the new one beside it.
templ fieldMarks(fs []fieldMark) {
	<ul class="pfields pmark" data-testid="proposal-fields">
		for _, f := range fs {
			<li data-testid="proposal-field">
				<span class="plabel">{ f.Label }</span>
				if f.Old != "" {
					<del>{ f.Old }</del>
				} else {
					<span class="muted">none</span>
				}
				if f.New != "" {
					<ins>{ f.New }</ins>
				} else {
					<span class="muted">none</span>
				}
			</li>
		}
	</ul>
}

func lineClass(m lineMark) string {
	switch m.Kind {
	case recipe.Removed:
		return "pline-removed"
	case recipe.Changed:
		return "pline-changed"
	}
	return ""
}

// lineMarkNote is what follows a marked line: the proposed text, or the word
// removed, or moved. It is hidden with the other marks.
templ lineMarkNote(m lineMark) {
	switch m.Kind {
		case recipe.Removed:
			<span class="pmark pnew" data-testid="proposal-line-removed">removed</span>
		case recipe.Changed:
			if m.Edited {
				<ins class="pmark pnew" data-testid="proposal-line-new">@lineText(m.New)</ins>
			} else {
				<span class="pmark pnew" data-testid="proposal-line-moved">moved</span>
			}
	}
}

templ addedLine(l display.Line) {
	<li class="pmark padd" data-testid="proposal-line-added"><ins>@lineText(l)</ins> <span class="muted">added</span></li>
}

// stepMarkNote follows a live step with what the proposal does to it: the old
// and new text of a change, or a note that it is removed or moved. The step
// above keeps its place, so the page reads as the live recipe with notes.
templ stepMarkNote(m stepMark, text, number string) {
	switch m.Kind {
		case recipe.Removed:
			<li class="pmark" data-testid="proposal-step-removed">
				<div>Step { number }</div>
				<div>
					<p class="plabel">Removed</p>
					<p><del>{ text }</del></p>
				</div>
			</li>
		case recipe.Changed:
			<li class="pmark" data-testid="proposal-step-changed">
				<div>Step { number }</div>
				<div>
					if m.Edited {
						<p class="plabel">Changed</p>
						<p><del>{ text }</del></p>
						<p><ins>{ m.New }</ins></p>
					} else {
						<p class="plabel">Moved to step { strconv.Itoa(m.NewNumber) }</p>
					}
				</div>
			</li>
	}
}

templ addedStep(text string) {
	<li class="pmark" data-testid="proposal-step-added">
		<div>New</div>
		<div>
			<p class="plabel">Added</p>
			<p><ins>{ text }</ins></p>
		</div>
	</li>
}

templ newPartMark(p newPart) {
	<div class="pmark pnewpart" data-testid="proposal-part-added">
		<h3>New part: { partLabel(p.Name) }</h3>
		<ul>
			for _, l := range p.Lines {
				<li><ins>{ l }</ins></li>
			}
			for _, s := range p.Steps {
				<li><ins>{ s }</ins></li>
			}
		</ul>
	</div>
}

// lineText is an ingredient line's text with each qualifier in its own muted
// italic element. The name and the first qualifier are set off by a space, and
// the qualifiers from each other by a comma. Line.Text keeps the comma form,
// name included, for every other surface.
templ lineText(l display.Line) {
	{ l.Head }
	for i, q := range l.Qualifiers {
		// The comma sits against the qualifier before it, in the same muted
		// italic, outside the qualifier's own element.
		if i < len(l.Qualifiers)-1 {
			<span class="qual" data-testid="qualifier">{ q }</span><span class="qual">,</span>
		} else {
			<span class="qual" data-testid="qualifier">{ q }</span>
		}
	}
	if l.Tail != "" {
		{ l.Tail }
	}
}
