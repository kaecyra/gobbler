package recipeview

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/recipe/display"
	"github.com/kaecyra/gobbler/internal/video"
	"github.com/kaecyra/gobbler/internal/web/layout"
	"github.com/kaecyra/gobbler/internal/web/ribbon"
)

// scalePresets are the one-tap multipliers; Param is the text sent as scale.
var scalePresets = []struct{ Param, Label string }{
	{"1/2", "½×"}, {"1", "1×"}, {"2", "2×"}, {"3", "3×"},
}

// unitModes are the display modes; Param is the text sent as units.
var unitModes = []struct{ Param, Label string }{
	{"", "As written"}, {display.UnitsMetric, "Metric"}, {display.UnitsWeight, "Weight"},
}

// libraryPath is the library, the first step of the breadcrumb.
const libraryPath = "/recipes"

// shoppingPath is where the shopping lists are; "Add to shopping list" goes
// there, since a list is chosen on its own page.
const shoppingPath = "/shopping"

// Paths of the player's own assets, embedded in the binary (ADR-00002).
const (
	videoStylesheetPath = "/static/video.css"
	videoScriptPath     = "/static/video.js"
)

// thumbnailHref is the stored preview of the recipe's video, reached through
// the recipe so the household check applies.
func thumbnailHref(id int64) string { return recipePath(id) + thumbnailRoute }

// videoWatchURL is where the play control goes without scripts. It is only
// followed when someone presses it.
func videoWatchURL(videoID string) string { return "https://www.youtube.com/watch?v=" + videoID }

// videoEmbedURL is the privacy-enhanced player that video.js loads on Play.
func videoEmbedURL(videoID string) string { return video.EmbedURL(videoID) }

// recipePath is the recipe page's path, the base of its sibling pages.
func recipePath(id int64) string {
	return "/recipes/" + strconv.FormatInt(id, 10)
}

// href is the URL of this recipe with the given state. Empty values are left
// out so the default view keeps the bare URL.
func href(id int64, scale, servings, units string) string {
	return display.StateURL(recipePath(id), scale, servings, units, nil)
}

// cookHref is the cook-mode page of this recipe with the same state. Cook mode
// is its own feature package (ADR-00012), so only its URL is known here.
func cookHref(id int64, o display.Options) string {
	return o.URL(recipePath(id)+"/cook", nil)
}

// journalHref is the journal of this recipe: loaded into the page by HTMX, and
// a plain link where scripts do not run. The journal is its own feature package
// (ADR-00012), so only its URL is known here.
func journalHref(id int64) string { return recipePath(id) + "/journal" }

// historyHref is the history page of this recipe.
func historyHref(id int64) string { return recipePath(id) + "/history" }

// cloneHref is where the clone form posts.
func cloneHref(id int64) string { return recipePath(id) + "/clone" }

// originHref is the history page of one version of the recipe a clone came from.
func originHref(o *originView) string {
	return historyHref(o.RecipeID) + "/" + strconv.FormatInt(o.Version, 10)
}

// editHref is the editor page of this recipe. The editor is its own feature
// package (ADR-00012), so only its URL is known here; it takes no display state.
func editHref(id int64) string {
	return recipePath(id) + "/edit"
}

// shareHref is the form that sends a copy of this recipe to another household.
// Sharing is its own feature package (ADR-00012), so only its URL is known here.
func shareHref(id int64) string {
	return "/shares/new/" + strconv.FormatInt(id, 10)
}

// spoonsOn lists the five spoons of the rating, true for the filled ones.
func spoonsOn(n int) []bool {
	out := make([]bool, maxSpoons)
	for i := range out {
		out[i] = i < n
	}
	return out
}

// chilis lists the peppers of the spice scale.
func chilis(n int) []struct{} { return make([]struct{}, n) }

// stepNumber is the number printed in a step's marker.
func stepNumber(first, i int) string { return strconv.Itoa(first + i) }

func presetActive(v view, param string) bool {
	if v.Opts.Servings != "" {
		return false
	}
	if v.Opts.Scale == "" {
		return param == "1"
	}
	return v.Opts.Scale == param
}

templ recipePage(v view) {
	@layout.Page(v.Name) {
		<link rel="stylesheet" href={ ribbon.StylesheetPath }/>
		@Styles()
		if v.VideoID != "" {
			@videoPlayer(v)
		}
		@recipeBody(v)
		@aside(v)
		<script src={ ribbon.ScriptPath } defer></script>
	}
}

// videoPlayer is the recipe's video at the top of the page (ADR-00021). Until
// Play is pressed it holds no address of a YouTube origin that the browser
// would load: the thumbnail is the application's own copy, and the player's
// address sits in a data attribute that video.js reads on click. The control
// is a link to the video's watch page, which is what a browser without
// scripts follows; video.js replaces it with the embedded player. It sits
// outside #recipe so scaling the recipe does not reset a playing video.
templ videoPlayer(v view) {
	<link rel="stylesheet" href={ videoStylesheetPath }/>
	<section class="recipe-video" aria-label="Video" data-testid="video">
		<a
			class="recipe-video-play"
			href={ templ.URL(videoWatchURL(v.VideoID)) }
			rel="noopener noreferrer"
			data-video-play
			data-embed={ videoEmbedURL(v.VideoID) }
			data-title={ "Video: " + v.Name }
			data-testid="video-play"
		>
			if v.HasThumbnail {
				<img src={ thumbnailHref(v.ID) } alt="" loading="lazy" data-testid="video-thumbnail"/>
			}
			<span class="recipe-video-button">Play video</span>
		</a>
	</section>
	<script src={ videoScriptPath } defer></script>
}

templ recipeBody(v view) {
	<article id="recipe" class="recipe">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href={ templ.SafeURL(libraryPath) }>Library</a>
			<span aria-hidden="true">/</span>
			if v.Meal != "" {
				<span>{ v.Meal }</span>
			} else {
				<span aria-current="page">{ v.Name }</span>
			}
		</nav>
		<div class="rhead">
			<div>
				<h1>{ v.Name }</h1>
				if v.Description != "" {
					<p class="lede">{ v.Description }</p>
				}
				if v.Origin != nil {
					<p class="muted origin" data-testid="origin">
						Cloned from
						<a href={ templ.SafeURL(recipePath(v.Origin.RecipeID)) }>recipe { strconv.FormatInt(v.Origin.RecipeID, 10) }</a>
						at
						<a href={ templ.SafeURL(originHref(v.Origin)) }>version { strconv.FormatInt(v.Origin.Version, 10) }</a>.
					</p>
				}
				@metaRow(v)
				if len(v.Tags) > 0 {
					<ul class="recipe-tags">
						for _, t := range v.Tags {
							<li class="stag">{ t }</li>
						}
					</ul>
				}
				<p class="recipe-yield">
					if v.Servings != "" {
						<span>Serves <strong data-testid="servings">{ v.Servings }</strong></span>
					}
					if v.Yield != "" {
						<span>Makes <strong data-testid="yield">{ v.Yield }</strong></span>
					}
				</p>
			</div>
			@times(v)
		</div>
		@controls(v)
		if v.Notice != "" {
			<p role="alert" class="recipe-error" data-testid="view-error">{ v.Notice }</p>
		}
		if v.Scaled {
			<p class="muted" data-testid="scaled-note">Scaled by { v.Multiplier }. Quantities are rounded for the kitchen; hover one for the exact value.</p>
		}
		<div class="recipe-grid">
			<div class="ingr">
				if len(v.Equipment) > 0 {
					<section class="equip" aria-labelledby="equipment-h">
						<h2 id="equipment-h" class="eyebrow">Equipment</h2>
						<ul data-testid="equipment">
							for _, e := range v.Equipment {
								<li data-testid="equipment-item">
									{ e.Text }
									if e.Hint != "" {
										<span class="muted" data-testid="equipment-hint"> ({ e.Hint })</span>
									}
								</li>
							}
						</ul>
					</section>
				}
				<section aria-labelledby="ingredients-h">
					<h2 id="ingredients-h" class="eyebrow">Ingredients</h2>
					for _, c := range v.Components {
						<div class="comp">
							if c.Name != "" {
								<h3>{ c.Name }</h3>
							}
							<ul class="ing">
								for _, l := range c.Lines {
									<li>
										if l.Exact != "" {
											<span title={ "exact: " + l.Exact }>{ l.Text }</span>
										} else {
											<span>{ l.Text }</span>
										}
										if l.Unscaled {
											<span class="muted"> (not scaled or converted: ingredient not matched)</span>
										}
									</li>
								}
							</ul>
						</div>
					}
				</section>
			</div>
			<section class="method" aria-labelledby="steps-h">
				<h2 id="steps-h" class="sr">Steps</h2>
				for _, t := range v.Tips {
					<div class="tip" data-testid="tip">
						<div class="co-label">
							@iconBulb()
							<span>Tip</span>
						</div>
						<p>{ t } <small>From your notes</small></p>
					</div>
				}
				for _, c := range v.Components {
					if len(c.Steps) > 0 {
						if c.Name != "" {
							<h3 class="part">{ c.Name }</h3>
						}
						<ol start={ strconv.Itoa(c.FirstStep) }>
							for i, s := range c.Steps {
								<li class={ "step", templ.KV("passive", s.Passive) }>
									<div class="sn" aria-hidden="true">{ stepNumber(c.FirstStep, i) }</div>
									<div>
										if s.Title != "" {
											<h4 data-testid="step-title">{ s.Title }</h4>
										}
										<p>{ s.Text }</p>
										if s.Note != "" || len(s.After) > 0 {
											<div class="stags">
												if s.Note != "" {
													<span class={ "stag", templ.KV("t", s.Passive) }>{ s.Note }</span>
												}
												if len(s.After) > 0 {
													<span class="stag dep">{ afterText(s.After) }</span>
												}
											</div>
										}
										@meanwhile(s.Meanwhile)
									</div>
								</li>
							}
						</ol>
					}
				}
			</section>
		</div>
	</article>
}

// metaRow is the line under the title: meal type, spice, rating, how often it
// was made and where it came from. Unset fields show nothing; an unrated
// recipe says "New".
templ metaRow(v view) {
	<div class="meta-row">
		if v.Meal != "" {
			<span class="mtype" data-testid="meal-type">
				@mealIcon(v.MealType)
				<span class="lbl">{ v.Meal }</span>
			</span>
		}
		if v.Spice > 0 {
			<span class="heat big" role="img" aria-label={ heatLabel(v.Spice) } title={ heatLabel(v.Spice) } data-testid="spice">
				for range chilis(v.Spice) {
					@chili()
				}
			</span>
		}
		if v.Spoons > 0 {
			<span class="spoons" role="img" aria-label={ verdict(v.Spoons) } title={ verdict(v.Spoons) } data-testid="rating">
				for _, on := range spoonsOn(v.Spoons) {
					@spoon(on)
				}
			</span>
		} else {
			<span data-testid="rating-new">New</span>
		}
		if v.Made > 0 {
			<span data-testid="made-count">Made { strconv.Itoa(v.Made) }×</span>
		}
		if v.Author != "" {
			<span>By { v.Author }</span>
		}
		if v.Calories != nil {
			<span>{ strconv.Itoa(*v.Calories) } kcal per serving</span>
		}
		if v.SourceURL != "" {
			<a class="srclink" href={ templ.URL(v.SourceURL) } target="_blank" rel="noopener noreferrer" data-testid="source-link">
				<span class="srck">Original recipe</span>
				if v.SourceHost != "" {
					<span>{ v.SourceHost }</span>
				}
				@iconExternal()
				<span class="sr">(opens in a new tab)</span>
			</a>
		}
	</div>
}

// aside holds what belongs to the recipe but not to its scaled view: it sits
// outside #recipe so scaling does not swap it, and the journal does not reload
// (and lose a half-typed note) on every tap.
templ aside(v view) {
	<aside aria-label="Recipe tools">
		<div class="recipe-after">
			<div data-testid="journal-slot" hx-get={ journalHref(v.ID) } hx-trigger="load" hx-swap="outerHTML">
				<a href={ templ.SafeURL(journalHref(v.ID)) } class="btn">Journal</a>
			</div>
			<div class="tools">
				<h2>History</h2>
				<ul class="tool-links">
					<li><a href={ templ.SafeURL(historyHref(v.ID)) } data-testid="history-link">History</a></li>
					<li><a href={ templ.SafeURL(editHref(v.ID)) } data-testid="edit-link">Edit</a></li>
					<li><a href={ templ.SafeURL(shareHref(v.ID)) } data-testid="share-link">Share</a></li>
				</ul>
				<form method="post" action={ templ.SafeURL(cloneHref(v.ID)) }>
					<button type="submit" class="btn" data-testid="clone-button">Clone this recipe</button>
				</form>
				<div class="snap"><i></i>Original source snapshot kept, unchanged</div>
			</div>
		</div>
	</aside>
}

// times is the ribbon's heading and the stated times. The derived total is
// the headline; prep, cook and the special times sit under the ribbon.
templ times(v view) {
	if v.readyIn() != "" || len(v.Times) > 0 {
		<div class="rtime">
			if v.readyIn() != "" {
				<span class="eyebrow">
					Ready in about
					<span data-testid="total">{ v.readyIn() }</span>
					if v.TotalNote != "" {
						<span class="muted"> ({ v.TotalNote })</span>
					}
				</span>
			}
			@ribbon.Large(v.Ribbon)
			if len(v.Times) > 0 {
				<dl class="recipe-times">
					for _, t := range v.Times {
						<div>
							<dt>{ t.Label }</dt>
							<dd>
								{ t.Text }
								if t.Hint != "" {
									<span class="muted"> ({ t.Hint })</span>
								}
							</dd>
						</div>
					}
				</dl>
			}
		</div>
	}
}

// controls are plain links and a GET form, so they work without scripts; the
// hx-* attributes only make HTMX swap the recipe in place.
templ controls(v view) {
	<div class="recipe-controls">
		<div class="seg" role="group" aria-label="Scale">
			for _, p := range scalePresets {
				<a
					href={ templ.SafeURL(href(v.ID, p.Param, "", v.Opts.Units)) }
					hx-get={ href(v.ID, p.Param, "", v.Opts.Units) }
					hx-target="#recipe"
					hx-select="#recipe"
					hx-swap="outerHTML"
					hx-push-url="true"
					if presetActive(v, p.Param) {
						aria-current="true"
					}
				>{ p.Label }</a>
			}
		</div>
		<form class="servings" method="get" action={ templ.SafeURL(href(v.ID, "", "", "")) } hx-get={ href(v.ID, "", "", "") } hx-target="#recipe" hx-select="#recipe" hx-swap="outerHTML" hx-push-url="true">
			<label>
				Servings
				<input type="text" name="servings" inputmode="decimal" value={ v.Opts.Servings } size="4"/>
			</label>
			if v.Opts.Units != "" {
				<input type="hidden" name="units" value={ v.Opts.Units }/>
			}
			<button type="submit" class="btn">Scale</button>
		</form>
		<div class="seg" role="group" aria-label="Units">
			for _, m := range unitModes {
				<a
					href={ templ.SafeURL(href(v.ID, v.Opts.Scale, v.Opts.Servings, m.Param)) }
					hx-get={ href(v.ID, v.Opts.Scale, v.Opts.Servings, m.Param) }
					hx-target="#recipe"
					hx-select="#recipe"
					hx-swap="outerHTML"
					hx-push-url="true"
					if v.Opts.Units == m.Param {
						aria-current="true"
					}
				>{ m.Label }</a>
			}
		</div>
		<span class="grow"></span>
		<a class="btn" href={ templ.SafeURL(shoppingPath) } data-testid="shopping-link">Add to shopping list</a>
		<a class="btn accent cookbtn" href={ templ.SafeURL(cookHref(v.ID, v.Opts)) } data-testid="cook-link">
			@iconPot()
			<span>Cook mode</span>
		</a>
	</div>
}
