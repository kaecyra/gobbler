package history

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/web/layout"
	"github.com/kaecyra/gobbler/internal/web/recipeview"
)

// crumbs is the path back to the recipe; the last entry is the page itself.
templ crumbs(id int64, name, here string) {
	<nav class="crumbs" aria-label="Breadcrumb">
		<a href={ templ.SafeURL(libraryPath) }>Library</a>
		<span aria-hidden="true">/</span>
		<a href={ templ.SafeURL(recipePath(id)) }>{ name }</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">{ here }</span>
	</nav>
}

templ listPage(v listView) {
	@layout.Page("History of " + v.Name) {
		@recipeview.Styles()
		@styles()
		<article class="recipe">
			@crumbs(v.ID, v.Name, "History")
			<div class="screen-h">
				<div>
					<h1>History of { v.Name }</h1>
					<p><a href={ templ.SafeURL(recipePath(v.ID)) } class="back">Back to the recipe</a></p>
				</div>
				<form method="post" action={ templ.SafeURL(recipePath(v.ID) + "/clone") }>
					<button type="submit" class="btn">Clone this recipe</button>
				</form>
			</div>
			if v.Origin != nil {
				<p class="muted origin" data-testid="origin">
					Cloned from
					<a href={ templ.SafeURL(recipePath(v.Origin.RecipeID)) }>recipe { strconv.FormatInt(v.Origin.RecipeID, 10) }</a>
					at
					<a href={ templ.SafeURL(versionPath(v.Origin.RecipeID, v.Origin.Version)) }>version { strconv.FormatInt(v.Origin.Version, 10) }</a>.
				</p>
			}
			<h2 class="versions-h">Versions</h2>
			<ol reversed data-testid="revisions" class="history-list">
				<li data-testid="current-version">
					<a href={ templ.SafeURL(versionPath(v.ID, v.Current.Version)) }>Version { strconv.FormatInt(v.Current.Version, 10) }</a>
					<span>(current), last changed { v.Current.When } by { v.Current.Who }</span>
				</li>
				for _, row := range v.Rows {
					<li data-testid="revision">
						<a href={ templ.SafeURL(versionPath(v.ID, row.Version)) }>Version { strconv.FormatInt(row.Version, 10) }</a>
						<span>
							if row.Restored != 0 {
								replaced by a restore of version { strconv.FormatInt(row.Restored, 10) }
							} else {
								replaced by an edit
							}
							on { row.When } by { row.Who }
						</span>
					</li>
				}
			</ol>
			if len(v.Rows) == 0 {
				<p class="muted" data-testid="empty">This recipe has not been edited, so no earlier versions are saved.</p>
			}
			<div class="snap"><i></i>Original source snapshot kept, unchanged</div>
		</article>
	}
}

templ versionPage(v versionView) {
	@layout.Page(v.Name + ", version " + strconv.FormatInt(v.Version, 10)) {
		@recipeview.Styles()
		@styles()
		<article class="recipe" data-testid="version">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href={ templ.SafeURL(libraryPath) }>Library</a>
				<span aria-hidden="true">/</span>
				<a href={ templ.SafeURL(historyPath(v.ID)) }>Back to the history</a>
			</nav>
			<p class="version-banner" data-testid="version-banner">
				if v.Current {
					Version { strconv.FormatInt(v.Version, 10) }, the current version.
				} else {
					Version { strconv.FormatInt(v.Version, 10) }, an earlier version. Read only.
				}
			</p>
			<div class="rhead">
				<div>
					<h1>{ v.Name }</h1>
					if v.Description != "" {
						<p class="lede">{ v.Description }</p>
					}
					<div class="meta-row">
						if v.Author != "" {
							<span>By { v.Author }</span>
						}
						if v.Rating != nil {
							<span>Rating { strconv.Itoa(*v.Rating) }/5</span>
						}
						if v.Calories != nil {
							<span>{ strconv.Itoa(*v.Calories) } kcal per serving</span>
						}
						if v.SourceURL != "" {
							<a class="srclink" href={ templ.URL(v.SourceURL) } target="_blank" rel="noopener noreferrer">
								<span class="srck">Original recipe</span>
								<span class="sr">(opens in a new tab)</span>
							</a>
						}
					</div>
					if len(v.Tags) > 0 {
						<ul class="recipe-tags">
							for _, t := range v.Tags {
								<li class="stag">{ t }</li>
							}
						</ul>
					}
					<p class="recipe-yield">
						if v.Servings != "" {
							<span>Serves <strong data-testid="servings">{ v.Servings }</strong></span>
						}
						if v.Yield != "" {
							<span>Makes <strong data-testid="yield">{ v.Yield }</strong></span>
						}
					</p>
				</div>
				if len(v.Times) > 0 || v.Total != "" {
					<div class="rtime">
						if v.Total != "" {
							<span class="eyebrow">
								Total
								<span data-testid="total">
									{ v.Total }
									if v.TotalNote != "" {
										<span class="muted"> ({ v.TotalNote })</span>
									}
								</span>
							</span>
						}
						<dl class="recipe-times">
							for _, t := range v.Times {
								<div>
									<dt>{ t.Label }</dt>
									<dd>{ t.Text }</dd>
								</div>
							}
						</dl>
					</div>
				}
			</div>
			<div class="recipe-grid">
				<div class="ingr">
					if len(v.Equipment) > 0 {
						<section class="equip" aria-labelledby="equipment-h">
							<h2 id="equipment-h" class="eyebrow">Equipment</h2>
							<ul data-testid="equipment">
								for _, e := range v.Equipment {
									<li>{ e }</li>
								}
							</ul>
						</section>
					}
					<section aria-labelledby="ingredients-h">
						<h2 id="ingredients-h" class="eyebrow">Ingredients</h2>
						for _, c := range v.Components {
							<div class="comp">
								if c.Name != "" {
									<h3>{ c.Name }</h3>
								}
								<ul class="ing">
									for _, l := range c.Lines {
										<li><span>{ l }</span></li>
									}
								</ul>
							</div>
						}
					</section>
				</div>
				<section class="method" aria-labelledby="steps-h">
					<h2 id="steps-h" class="sr">Steps</h2>
					for _, c := range v.Components {
						if len(c.Steps) > 0 {
							if c.Name != "" {
								<h3 class="part">{ c.Name }</h3>
							}
							<ol start={ strconv.Itoa(c.FirstStep) }>
								for i, s := range c.Steps {
									<li class="step">
										<div class="sn" aria-hidden="true">{ strconv.Itoa(c.FirstStep + i) }</div>
										<div>
											<p>{ s.Text }</p>
											if s.Note != "" || len(s.After) > 0 {
												<div class="stags">
													if s.Note != "" {
														<span class="stag">{ s.Note }</span>
													}
													if len(s.After) > 0 {
														<span class="stag dep" data-testid="after">after step { joinSteps(s.After) }</span>
													}
												</div>
											}
										</div>
									</li>
								}
							</ol>
						}
					}
				</section>
			</div>
			if !v.Current {
				<section class="restore" aria-labelledby="restore-h">
					<h2 id="restore-h">Restore</h2>
					<details>
						<summary>Restore this version</summary>
						<p>
							This makes version { strconv.FormatInt(v.Version, 10) } the current recipe.
							The recipe as it is now is kept in the history, so nothing is lost.
						</p>
						<form method="post" action={ templ.SafeURL(versionPath(v.ID, v.Version) + "/restore") }>
							<input type="hidden" name="confirm" value="yes"/>
							<button type="submit" class="btn accent">Yes, restore version { strconv.FormatInt(v.Version, 10) }</button>
						</form>
					</details>
				</section>
			}
		</article>
	}
}
