package profile

import "github.com/kaecyra/gobbler/internal/web/layout"

// avatarDialog is the modal that holds the picture flow (ADR-00033). The avatar
// button opens the system's file chooser directly; choosing a file opens this
// dialog while the picture uploads, then shows the square to keep. Each step is
// a fragment that replaces #avatar-panel, so nothing leaves the dialog. The
// status of the job lives on the page (avatarStatusSlot), not in the dialog;
// data-status-src is where profile.js reloads it when the dialog closes. Escape
// closes a modal <dialog> natively; profile.js opens it, wires the close button
// and throws away a crop left unsaved.
templ avatarDialog(v pageView) {
	<dialog class="avatar-dialog" id="avatar-dialog" aria-labelledby="avatar-h" data-status-src={ newPanelView(v.Address, v.Shown.Avatar, "").statusSrc() } data-testid="profile-avatar-form">
		<link rel="stylesheet" href="/static/avatar.css"/>
		<div class="avatar-dialog-head">
			<h2 id="avatar-h">Change your picture</h2>
			<button type="button" class="btn" data-avatar-close data-testid="avatar-close">Close</button>
		</div>
		<div class="avatar-problem" role="alert" hidden data-avatar-error data-testid="avatar-error">
			<p data-avatar-error-text></p>
		</div>
		@uploadPanel(newPanelView(v.Address, v.Shown.Avatar, ""))
	</dialog>
}

// uploadPanel is the first step: the form that uploads a picture. Message is
// why the last attempt was refused. Without scripts the form is shown as it is.
// In the dialog the form is hidden and the Choose button opens the file chooser
// instead; profile.js submits the form as soon as a file is chosen and shows
// the loading line until the crop step arrives.
templ uploadPanel(v panelView) {
	<div id="avatar-panel" data-step="upload" data-testid="avatar-panel">
		<h3 tabindex="-1" data-step-heading>Pick a picture</h3>
		if v.Message != "" {
			<div class="avatar-problem" role="alert" data-testid="avatar-message"><p>{ v.Message }</p></div>
		}
		<form class="avatar-pick" method="post" enctype="multipart/form-data" action={ templ.SafeURL(v.path("avatar")) } hx-post={ v.path("avatar") } hx-encoding="multipart/form-data" hx-target="#avatar-panel" hx-swap="outerHTML">
			<label>
				Choose a picture
				<input type="file" name="avatar" accept={ uploadAccept } required/>
			</label>
			<button type="submit" class="btn accent">Upload</button>
		</form>
		<button type="button" class="btn accent avatar-choose" data-avatar-choose data-testid="avatar-choose">Choose a picture</button>
		<p class="muted">JPEG, PNG, GIF, WebP, HEIC or AVIF, up to { maxUploadMB } MB. You choose the square to keep on the next step.</p>
		<p class="avatar-loading" role="status" hidden data-avatar-loading data-testid="avatar-loading">Loading your picture…</p>
	</div>
}

// avatarStatusSlot is where the status of the person's last upload appears: a
// page-level message, shown only while something is pending or went wrong. It
// loads as a fragment (statusFragment) so it can poll while the picture is
// processed in the background. Each page that shows a step has exactly one,
// outside #avatar-panel, so a step can update it out of band (savedPanel).
// The hidden message beside it is what avatar.js fills and shows when the
// status itself cannot be fetched.
templ avatarStatusSlot(v panelView) {
	<div id="avatar-status" class="avatar-status" data-testid="avatar-status" hx-get={ v.statusSrc() } hx-trigger="load" hx-swap="outerHTML"></div>
	<div class="callout check avatar-status-problem" role="alert" hidden data-avatar-status-problem data-testid="avatar-status-problem">
		<div class="co-label">
			@layout.Icon(layout.IconAlert)
			<span data-avatar-status-problem-label>Check</span>
		</div>
		<p data-avatar-status-problem-text></p>
	</div>
}

// cropPanel is the second step: the square to keep, drawn with Cropper.js
// (embedded under /static/vendor). The form carries the rectangle as fractions
// of the picture, so it still posts the whole picture when scripts are off. The
// server checks the rectangle again; the page is only a way to choose it.
templ cropPanel(v cropView) {
	<div id="avatar-panel" data-step="crop" data-testid="avatar-panel">
		<h3 tabindex="-1" data-step-heading>Choose the square to keep</h3>
		if v.Failed != "" {
			<div class="avatar-problem" role="alert"><p>{ v.Failed }</p></div>
		}
		<p class="muted">Drag the square to choose the part to keep.</p>
		<div class="crop-stage">
			<img id="crop-image" src={ v.path("avatar/preview/" + v.ID) } alt="The picture to crop" data-testid="crop-image"/>
		</div>
		<form class="crop-form" method="post" action={ templ.SafeURL(v.path("avatar/crop")) } hx-post={ v.path("avatar/crop") } hx-target="#avatar-panel" hx-swap="outerHTML" data-crop-form>
			<input type="hidden" name="id" value={ v.ID }/>
			<input type="hidden" name="x" value="0" data-crop="x"/>
			<input type="hidden" name="y" value="0" data-crop="y"/>
			<input type="hidden" name="w" value="1" data-crop="w"/>
			<input type="hidden" name="h" value="1" data-crop="h"/>
			<button type="submit" class="btn accent" data-testid="crop-save">Use this picture</button>
			<a class="btn" href={ templ.SafeURL(Pattern + "/" + v.Address) } data-crop-cancel data-testid="crop-cancel">Cancel</a>
		</form>
	</div>
}

// savedPanel is the step after the crop: the job is processing. The status
// fragment replaces the page's #avatar-status out of band and polls there until
// the profile has the new picture; in the dialog, profile.js closes the dialog
// on this step so the person sees that status on the page.
templ savedPanel(v statusView) {
	<div id="avatar-panel" data-step="saved" data-testid="avatar-panel">
		<h3 tabindex="-1" data-step-heading>Saving your picture</h3>
	</div>
	@statusFragment(v)
}

// statusFragment says where the person's last upload stands, as a callout:
// grey while it waits on something, amber when it needs a look. With nothing
// pending it is empty, and the page shows no message. While it is processing
// it polls itself. Its links go to the crop step: in the dialog
// (profile.js opens it on data-avatar-resume), or as a page without scripts.
templ statusFragment(v statusView) {
	switch v.State {
		case "queued":
			<div id="avatar-status" class="callout avatar-status" data-testid="avatar-status" data-state="queued" { v.oobAttrs()... } role="status" hx-get={ v.statusPath() } hx-trigger="every 2s" hx-swap="outerHTML">
				<div class="co-label">
					@layout.Icon(layout.IconClock)
					<span>Your picture</span>
				</div>
				<p>Processing your picture. This page updates when it is ready.</p>
			</div>
		case "uploaded":
			<div id="avatar-status" class="callout avatar-status" data-testid="avatar-status" data-state="uploaded" { v.oobAttrs()... } role="status">
				<div class="co-label">
					@layout.Icon(layout.IconClock)
					<span>Your picture</span>
				</div>
				<p>Your picture is waiting to be cropped. <a class="link" href={ templ.SafeURL(v.cropPath()) } hx-get={ v.cropPath() } data-avatar-resume hx-target="#avatar-panel" hx-swap="outerHTML">Choose the square to keep</a></p>
			</div>
		case "failed":
			<div id="avatar-status" class="callout check avatar-status" data-testid="avatar-status" data-state="failed" { v.oobAttrs()... } role="alert">
				<div class="co-label">
					@layout.Icon(layout.IconAlert)
					<span>Check</span>
				</div>
				<p>{ v.Error }</p>
				<p><a class="link" href={ templ.SafeURL(v.cropPath()) } hx-get={ v.cropPath() } data-avatar-resume hx-target="#avatar-panel" hx-swap="outerHTML">Try the crop again</a> or upload another picture.</p>
			</div>
		default:
			<div id="avatar-status" class="avatar-status" data-testid="avatar-status" data-state="none" { v.oobAttrs()... }></div>
	}
}

// uploadScreen is the upload step on a page of its own. The avatar on the
// profile links here, so a browser without scripts, or without <dialog>, still
// reaches the upload form; its upload goes on to the crop page (cropScreen) and
// the crop back to the profile. With scripts the same markup works in place.
templ uploadScreen(v panelView) {
	@layout.Page("Change your picture") {
		<div class="pg avatar-crop">
			<link rel="stylesheet" href="/static/vendor/cropper.min.css"/>
			<link rel="stylesheet" href="/static/avatar.css"/>
			<section class="panel" aria-labelledby="upload-h">
				<h1 id="upload-h">Change your picture</h1>
				@uploadPanel(v)
				@avatarStatusSlot(v)
				<p><a class="link" href={ templ.SafeURL(Pattern + "/" + v.Address) }>Back to your profile</a></p>
			</section>
			<script src="/static/vendor/cropper.min.js"></script>
			<script src="/static/avatar.js"></script>
		</div>
	}
}

// cropScreen is the crop step on a page of its own: where the upload page's
// form lands without scripts. The dialog
// shows the same step (cropPanel) in place.
templ cropScreen(v cropView) {
	@layout.Page("Crop your picture") {
		<div class="pg avatar-crop">
			<link rel="stylesheet" href="/static/vendor/cropper.min.css"/>
			<link rel="stylesheet" href="/static/avatar.css"/>
			<section class="panel" aria-labelledby="crop-h">
				<h1 id="crop-h">Crop your picture</h1>
				@cropPanel(v)
				@avatarStatusSlot(newPanelView(v.Address, v.Has, ""))
			</section>
			<script src="/static/vendor/cropper.min.js"></script>
			<script src="/static/avatar.js"></script>
		</div>
	}
}
