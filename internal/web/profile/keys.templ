package profile

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/apikey"
	"github.com/kaecyra/gobbler/internal/web/layout"
)

// keysSection is the profile page's entry to the personal API keys.
templ keysSection(v pageView) {
	<section class="panel" aria-labelledby="keys-h" data-testid="profile-keys">
		<h2 id="keys-h">API keys</h2>
		<p class="muted">A personal key lets an agent or script act as you. It reaches only what you can reach, and stops working when you leave your household.</p>
		<p><a class="btn" href={ templ.SafeURL(v.sectionPath("keys")) }>Manage your API keys</a></p>
	</section>
}

// keysPage lists the person's keys and makes new ones.
templ keysPage(v pageView, keys []keyRow) {
	@layout.Page("API keys") {
		<div class="pg profile">
			<section class="panel" aria-labelledby="keys-page-h" data-testid="profile-keys-page">
				<p class="eyebrow">Your profile</p>
				<h1 id="keys-page-h">Your API keys</h1>
				<p class="muted">A personal key acts as you. Only you see this list. A key is shown once, when you make it, and can be revoked here at any time.</p>
				if len(keys) > 0 {
					<ul class="list" data-testid="key-list">
						for _, k := range keys {
							<li data-testid="key">
								<span class="grow">
									<strong>{ k.Name }</strong>
									<span class="muted"> { k.Prefix }&hellip; made { k.Created }. { k.Expiry }. { k.Used }.</span>
								</span>
								<form class="row-form" method="post" action={ templ.SafeURL(v.keyRevokePath(k.ID)) }>
									<button type="submit" class="btn" aria-label={ "Revoke the key " + k.Name }>Revoke</button>
								</form>
							</li>
						}
					</ul>
				} else {
					<p data-testid="keys-empty">You have no keys.</p>
				}
				<form class="fields" method="post" action={ templ.SafeURL(v.sectionPath("keys")) }>
					<label>
						Name
						<input type="text" name="name" required maxlength={ strconv.Itoa(apikey.MaxNameRunes) } autocomplete="off" placeholder="Laptop agent"/>
					</label>
					<label>
						Expires
						<select name="lifetime">
							for _, l := range apikey.Lifetimes {
								<option value={ l.Value } selected?={ l.Value == apikey.DefaultLifetime }>{ l.Label }</option>
							}
						</select>
					</label>
					<button type="submit" class="btn accent">Make a key</button>
				</form>
				<p><a class="link" href={ templ.SafeURL(Pattern + "/" + v.Address) }>Back to your profile</a></p>
			</section>
		</div>
	}
}

// keyCreatedPage shows the secret of a key just made. It is the only time the
// secret is shown; nothing keeps it.
templ keyCreatedPage(v pageView, name, secret string) {
	@layout.Page("New API key") {
		<div class="pg profile">
			<section class="panel" aria-labelledby="key-new-h" data-testid="key-created">
				<h1 id="key-new-h">Copy the key now</h1>
				<p>Here is your key <strong>{ name }</strong>. It is shown only once. Gobbler keeps no copy that can be shown again, so make a new key if you lose this one.</p>
				<div class="fields">
					<label>
						Key
						<input type="text" readonly value={ secret } data-testid="key-secret" autocomplete="off"/>
					</label>
				</div>
				<p><a class="btn accent" href={ templ.SafeURL(v.sectionPath("keys")) }>Back to your keys</a></p>
			</section>
		</div>
	}
}
