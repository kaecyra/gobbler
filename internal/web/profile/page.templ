package profile

import (
	"github.com/kaecyra/gobbler/internal/web/layout"
)

// page is the profile page: the person, then the sections. See the package
// documentation for how a section is added.
templ page(v pageView) {
	@layout.Page(v.title()) {
		<div class="pg profile">
			@identity(v)
			@selfSections(v)
		</div>
	}
}

// identity is who the profile is: the avatar, the name and the email, each
// shown only where the visibility rule allowed it. For the person themself the
// avatar is a link to the upload page that profile.js turns into a button which
// opens the file chooser, so a browser without scripts still reaches the
// upload. The status of their last upload sits under the email.
templ identity(v pageView) {
	<section class="panel profile-head" aria-labelledby="profile-h" data-testid="profile-identity">
		if v.Shown.Seed != "" {
			if v.Self {
				<link rel="stylesheet" href="/static/profile.css"/>
				<a href={ templ.SafeURL(v.sectionPath("avatar/upload")) } role="button" class="profile-avatar profile-avatar-btn" aria-label="Change your picture" data-avatar-open data-testid="profile-avatar">
					@avatarPicture(v)
					<span class="avatar-edit" aria-hidden="true" data-testid="avatar-edit">
						@layout.Icon(layout.IconPencil)
					</span>
				</a>
			} else {
				<div class="profile-avatar" data-testid="profile-avatar">
					@avatarPicture(v)
				</div>
			}
		}
		<div class="profile-who">
			if v.Self {
				<p class="eyebrow">Your profile</p>
			}
			<h1 id="profile-h" data-testid="profile-name">{ v.title() }</h1>
			if v.Shown.Email != "" {
				<p class="muted" data-testid="profile-email">{ v.Shown.Email }</p>
			}
			if v.Self {
				@avatarStatusSlot(newPanelView(v.Address, v.Shown.Avatar, ""))
			}
		</div>
	</section>
	if v.Self {
		<link rel="stylesheet" href="/static/vendor/cropper.min.css"/>
		@avatarDialog(v)
		<script src="/static/vendor/cropper.min.js" defer></script>
		<script src="/static/avatar.js" defer></script>
		<script src="/static/profile.js" defer></script>
	}
}

// avatarPicture is the person's uploaded picture, or the default drawn from
// their email.
templ avatarPicture(v pageView) {
	if v.Shown.Avatar != "" {
		<img class="avatar" src={ avatarSrcOf(v) } alt="" width="96" height="96" style="object-fit: cover" data-testid="profile-avatar-img"/>
	} else {
		@layout.Avatar(v.Shown.Seed)
	}
}

// selfSections are the sections only the profile's person sees: they render
// only when the viewer is that person, and their routes are behind selfOnly.
// A later node adds its section as one line here, in the order the page shows
// them: profile, household, API keys, connected apps, sessions. The avatar's
// editor is not a section; it is the dialog the avatar button opens (identity).
templ selfSections(v pageView) {
	if v.Self {
		@nameSection(v)
		@householdSection(v)
		@keysSection(v)
		@grantsSection(v)
		@sessionsSection(v)
	}
}
