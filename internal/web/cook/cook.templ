package cook

import (
	"strconv"

	"github.com/kaecyra/gobbler/internal/web/layout"
)

// Asset URLs served from the embedded static directory by package web.
const (
	stylesheetPath = "/static/cook.css"
	timersPath     = "/static/cook-timers.js"
	scriptPath     = "/static/cook.js"
)

// cookPage is drawn after #cook in docs/ui/mockup.html: a header row with the
// way back, the recipe, its servings and units and the progress bar; the step
// on the left; timers, what comes next and the author's notes on a sunk side
// column; Back and Next under both.
templ cookPage(p page) {
	@layout.Page(p.Name + " - cook mode") {
		<link rel="stylesheet" href={ stylesheetPath }/>
		<article id="cook" class="cook" data-recipe={ strconv.FormatInt(p.ID, 10) }>
			<header class="cook-head">
				<a class="btn cook-back" href={ templ.SafeURL(p.ExitHref) } data-cook-exit data-testid="cook-exit">
					@layout.Icon(layout.IconBack)
					<span>Back to recipe</span>
				</a>
				<h1>{ p.Name }</h1>
				<span class="cook-meta" data-testid="cook-meta">{ p.Meta }</span>
				if !p.Empty {
					@progress(p.StepList)
				}
			</header>
			<p id="cook-wake" class="cook-wake" role="status" data-testid="wake-status" hidden></p>
			if p.Empty {
				<p class="cook-empty" data-testid="cook-empty">This recipe has no steps yet, so there is nothing to cook through. <a href={ templ.SafeURL(p.ExitHref) }>Back to the recipe</a>.</p>
			} else {
				@stepPanel(p)
			}
			@timersPanel()
		</article>
		<script src={ timersPath } defer></script>
		<script src={ scriptPath } defer></script>
	}
}

// progress is one bar per step. It sits in the header, outside the swapped
// step panel, so cook.js moves the current mark after each step swap from the
// panel's data-current.
templ progress(steps []listItem) {
	<div id="cook-prog" class="cook-prog" aria-hidden="true">
		for _, s := range steps {
			<i class={ progClass(s) }></i>
		}
	</div>
}

// timersPanel sits outside the swapped step panel so running timers survive
// stepping. cook.js fills the list.
templ timersPanel() {
	<section class="cook-timers" aria-labelledby="cook-timers-h">
		<img class="cook-peek" src={ layout.MascotWhisk } alt="" width="96" height="93"/>
		<div class="cook-timers-box">
			<h2 id="cook-timers-h" class="sr">Timers</h2>
			<p class="muted" id="cook-timers-empty" data-testid="timers-empty">No timers running.</p>
			<ul id="cook-timer-list" data-testid="timer-list"></ul>
			<p id="cook-alert" class="cook-alert" role="alert" data-testid="timer-alert"></p>
		</div>
	</section>
}

templ stepPanel(p page) {
	<div id="cook-step" class="cook-step" data-testid="cook-step" data-current={ strconv.Itoa(p.Current) }>
		<section class="cook-main" aria-label="Current step">
			<p class="eyebrow cook-progress" data-testid="progress">
				Step { strconv.Itoa(p.Current) } of { strconv.Itoa(p.Total) }
				if p.Component != "" {
					{ " · " + p.Component }
				}
				if p.IsMeanwhile {
					{ " · meanwhile" }
				}
			</p>
			if p.Step.Title != "" {
				<h2 class="cook-title" data-testid="step-title">{ p.Step.Title }</h2>
			}
			<div class="cook-text md" data-testid="step-text">
				@layout.Markdown(p.Step.Text)
			</div>
			if p.Step.Note != "" || p.Step.Seconds > 0 {
				<div class="cook-when">
					if p.Step.Seconds > 0 {
						<button
							type="button"
							class="cook-timer-start"
							data-cook-timer
							data-step={ strconv.Itoa(p.Step.Number) }
							data-label={ p.Step.Label }
							data-seconds={ strconv.Itoa(p.Step.Seconds) }
							data-duration={ timerLabel(p.Step.Seconds) }
							data-testid="timer-start"
						>Start timer ({ timerLabel(p.Step.Seconds) })</button>
					}
					if p.Step.Note != "" {
						<span class="muted" data-testid="step-note">{ p.Step.Note }</span>
					}
				</div>
			}
			if len(p.Lines) > 0 {
				<section class="cook-uses" aria-labelledby="cook-ing-h">
					<h2 id="cook-ing-h" class="sr">Ingredients</h2>
					<ul class="cook-chips" data-testid="cook-ingredients">
						for _, l := range p.Lines {
							<li>
								if l.Exact != "" {
									<span title={ "exact: " + l.Exact }>{ l.Text }</span>
								} else {
									<span>{ l.Text }</span>
								}
								if l.Unscaled {
									<span class="muted"> (not scaled or converted: ingredient not matched)</span>
								}
							</li>
						}
					</ul>
				</section>
			}
			if len(p.Equipment) > 0 {
				<section class="cook-uses" aria-labelledby="cook-eq-h">
					<h2 id="cook-eq-h" class="sr">Equipment</h2>
					<ul class="cook-chips" data-testid="cook-equipment">
						for _, e := range p.Equipment {
							<li class="equip-chip">
								@layout.EquipIcon(e.Name)
								<span>{ e.Text }</span>
							</li>
						}
					</ul>
				</section>
			}
		</section>
		if len(p.Meanwhile) > 0 || p.UpNext != nil {
			<aside class="cook-upnext" aria-label="What comes next">
				@meanwhile(p)
				if p.UpNext != nil {
					<div class="cook-go" data-testid="up-next">
						<span class="eyebrow">Up next</span>
						@goTo(p.UpNext.Number, p.UpNext.Href, false)
						@stepLabel(p.UpNext.Title, p.UpNext.Text)
					</div>
				}
			</aside>
		}
		@authorNotes(p.Notes)
		<nav class="cook-nav" aria-label="Steps">
			if p.PrevHref != "" {
				<a class="cook-btn" href={ templ.SafeURL(p.PrevHref) } hx-get={ p.PrevHref } hx-target="#cook-step" hx-select="#cook-step" hx-swap="outerHTML" hx-push-url="true" rel="prev" data-testid="prev">Back</a>
			} else {
				<span class="cook-btn disabled" aria-disabled="true">Back</span>
			}
			if p.NextHref != "" {
				<a class="cook-btn next" href={ templ.SafeURL(p.NextHref) } hx-get={ p.NextHref } hx-target="#cook-step" hx-select="#cook-step" hx-swap="outerHTML" hx-push-url="true" rel="next" data-testid="next">Next step</a>
			} else {
				<span class="cook-btn next disabled" aria-disabled="true">Next step</span>
			}
		</nav>
		<details class="cook-all">
			<summary data-testid="step-list-toggle">All steps</summary>
			<ol class="cook-steps" data-testid="step-list">
				for _, s := range p.StepList {
					<li class="cook-go">
						@goTo(s.Number, s.Href, s.Current)
						@stepLabel(s.Title, s.Text)
					</li>
				}
			</ol>
		</details>
	</div>
}

// goTo is the link to another step from a list row: "Step 4" and a chevron at
// the row's end, with the whole row as its tap target (cook.css, .cook-go).
// The step's words sit beside it in stepLabel rather than inside it, because
// step text may hold links of its own and links cannot nest.
templ goTo(n int, href string, current bool) {
	<a
		class="cook-go-n"
		href={ templ.SafeURL(href) }
		hx-get={ href }
		hx-target="#cook-step"
		hx-select="#cook-step"
		hx-swap="outerHTML"
		hx-push-url="true"
		if current {
			aria-current="step"
		}
	>
		<span>Step { strconv.Itoa(n) }</span>
		@layout.Icon(layout.IconChevron)
	</a>
}

// stepLabel names a step in a list: its title when it has one, else its text
// through the one markdown renderer (ADR-00046).
templ stepLabel(title, text string) {
	if title != "" {
		<b class="cook-go-t">{ title }</b>
	} else {
		<div class="cook-go-t md">
			@layout.Markdown(text)
		</div>
	}
}

func progClass(s listItem) string {
	switch {
	case s.Current:
		return "cur"
	case s.Done:
		return "done"
	}
	return ""
}

// meanwhile lists the work offered while a passive step runs, above up next.
// It renders nothing when there is none.
templ meanwhile(p page) {
	if len(p.Meanwhile) > 0 {
		<div class="cook-meanwhile" data-testid="meanwhile">
			<span class="eyebrow">Meanwhile</span>
			<ul>
				for _, it := range p.Meanwhile {
					<li class="cook-go">
						@goTo(it.Number, it.Href, false)
						@stepLabel(it.Title, it.Text)
					</li>
				}
			</ul>
		</div>
	}
}

// authorNotes is the "Author's Notes" button and the notes it opens
// (ADR-00041). The panel is a popover, so the button works without a script
// and the panel closes on Escape or a tap outside it. It renders nothing when
// the recipe has no author notes. Note text goes through the one markdown
// renderer (ADR-00046).
templ authorNotes(notes []noteView) {
	if len(notes) > 0 {
		<p class="cook-notes-row">
			<button type="button" class="btn cook-notes-open" popovertarget="cook-notes" data-testid="notes-open">
				@layout.Icon(layout.IconBulb)
				<span>Author's Notes</span>
			</button>
		</p>
		<div id="cook-notes" class="cook-notes-panel" popover aria-labelledby="cook-notes-h" data-testid="notes-panel">
			<h2 id="cook-notes-h" class="eyebrow">Author's Notes</h2>
			<ul data-testid="notes-list">
				for _, n := range notes {
					<li class="md" data-testid="author-note">
						if n.Lead != "" {
							<b>{ n.Lead }</b>
						}
						{ " " }
						@layout.Markdown(n.Text)
						<small>From the author</small>
					</li>
				}
			</ul>
			<button type="button" class="btn" popovertarget="cook-notes" popovertargetaction="hide" data-testid="notes-close">Close</button>
		</div>
	}
}
