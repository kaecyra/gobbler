# Copy to .env and fill in. Secrets live only in .env, which is never
# committed. Empty values mean "unset" and use the default.

# --- Image (ADR-00026) ------------------------------------------------------
# Version of ghcr.io/kaecyra/gobbler that Compose runs, e.g. 0.80.0. Required:
# there is no default. Upgrade by changing it, then `docker compose pull`.
GOBBLER_VERSION=

# --- Sign-in (ADR-00030) ----------------------------------------------------
# The only identity source: gobbler refuses to start without the first four.
# The issuer for Google is https://accounts.google.com; set up the OAuth client
# as docs/operations.md describes. The redirect URI is built from the public
# base URL, which is an https origin with no path.
GOBBLER_OIDC_ISSUER=https://accounts.google.com
GOBBLER_OIDC_CLIENT_ID=
GOBBLER_OIDC_CLIENT_SECRET=
GOBBLER_PUBLIC_BASE_URL=https://gobbler.example.com
# A session ends this long after sign-in (Go duration; 720h is 30 days).
# GOBBLER_SESSION_LIFETIME=720h
# Peers whose CF-Connecting-IP header is believed: IP addresses or CIDR ranges,
# comma-separated. cloudflared runs on the VM and arrives from the Compose
# network's gateway, so set that address (docs/operations.md, Trusted proxies).
# Empty: the header is never read and the per-address limits see the proxy.
# GOBBLER_TRUSTED_PROXIES=172.18.0.1
# Per-address leaky buckets on /oauth/register and /oauth/token (ADR-00036).
# GOBBLER_OAUTH_REGISTER_RATE=0.1
# GOBBLER_OAUTH_REGISTER_BURST=10
# GOBBLER_OAUTH_TOKEN_RATE=1
# GOBBLER_OAUTH_TOKEN_BURST=20

# Invitation emails per sender, invites and resends together (ADR-00055). The
# SMTP settings are on the operator's Deployment page, not here (docs/operations.md, Mail).
# GOBBLER_MAIL_RATE=0.05
# GOBBLER_MAIL_BURST=10

# --- Operator (ADR-00018) ---------------------------------------------------
# Comma-separated emails of the operator(s). An operator reaches /settings and
# the other operator pages without being a household member, so set this before
# first use: it is how the first household invitation gets issued. Sign-in
# proves who a person is; the app decides admission.
GOBBLER_OPERATOR_EMAILS=

# --- Server -----------------------------------------------------------------
# compose.yaml sets the listen address, data directory and turns the dev auth
# bypass off. They are listed so every setting is documented in one place.
# GOBBLER_LISTEN_ADDR=127.0.0.1:8080
# GOBBLER_DATA_DIR=data
# GOBBLER_DEV_AUTH_BYPASS=false
# debug, info, warn or error
GOBBLER_LOG_LEVEL=info

# --- Ingestion (ADR-00006) --------------------------------------------------
# Drafts scoring below the threshold (0 to 1) fall back to the LLM.
GOBBLER_INGEST_CONFIDENCE_THRESHOLD=0.7
GOBBLER_INGEST_FETCH_TIMEOUT=15s
# Empty uses the built-in user agent.
GOBBLER_INGEST_USER_AGENT=

# --- LLM (ADR-00056) ---------------------------------------------------------
# There are no LLM settings here. The provider and model for text and for
# vision, the timeout and the API keys are entered by an operator on the
# Deployment page, /operator/settings, and kept in the database. The old
# GOBBLER_LLM_* variables and the two provider key variables are ignored; the
# log names each one that is still set.

# --- Integration secrets (ADR-00057) ---------------------------------------
# The key the secrets saved on the operator's Deployment page are encrypted
# under: 32 random bytes, base64. Generate one with:
#   openssl rand -base64 32
# Keep it with your backups of .env. Without it, or with a different one,
# saved secrets read as unreadable and must be entered again.
GOBBLER_ENCRYPTION_KEY=

# --- Backups (ADR-00010) ----------------------------------------------------
# Local backups go to <data dir>/backups. Daily run time, 24-hour HH:MM.
GOBBLER_BACKUP_SCHEDULE=03:00
GOBBLER_BACKUP_LOCAL_RETENTION=7
GOBBLER_BACKUP_REMOTE_RETENTION=30
# Remote copy: leave every S3 setting empty for local-only backups, otherwise
# set all but the prefix.
GOBBLER_S3_ENDPOINT=
GOBBLER_S3_REGION=
GOBBLER_S3_BUCKET=
GOBBLER_S3_PREFIX=
GOBBLER_S3_ACCESS_KEY_ID=
GOBBLER_S3_SECRET_ACCESS_KEY=
# Uploaded media (ADR-00033): a second bucket on the same endpoint. Empty keeps
# media in <data dir>/media.
GOBBLER_S3_MEDIA_BUCKET=
